[Unit]
Description=home-warden nginx (unprivileged)
Documentation=https://github.com/the-hcma/home-warden/blob/main/docs/architecture-socket-activation.md
Requires=home-warden.socket
After=network.target home-warden.socket
# Give up after a burst of crashes instead of restarting every RestartSec
# forever; `systemctl reset-failed home-warden.service` (or setup-service)
# re-arms it once the cause is fixed.
StartLimitIntervalSec=10min
StartLimitBurst=20

[Service]
Type=simple
User=@@OWNER@@
Group=@@OWNER@@
Environment=NGINX=3:4;
Environment=DEPLOYED_COMMIT=@@DEPLOYED_COMMIT@@
# -p sets prefix for relative pid/temp/log paths in the home nginx.conf.
ExecStart=/usr/sbin/nginx -p @@SCRATCH_DIR@@/ -c @@HOME_NGINX_CONF@@ -g 'daemon off;'
# Do not run `nginx -s reload` here: that helper inherits Environment=NGINX=3:4;
# without socket fds and logs getsockname() EBADF. Signal the master instead.
ExecReload=/usr/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
# Bind privileged ports only via inherited fds from home-warden.socket.
NoNewPrivileges=true
# --- Sandboxing (home-warden#42) ---
# Whole filesystem read-only except the paths reopened below.
ProtectSystem=strict
# Replace /home, /root and /run/user with an empty tmpfs, then bind back only
# the paths nginx needs. Not ProtectHome=true + ReadOnlyPaths=: that masks
# /home with a mode-000 directory, which an unprivileged User= with an empty
# CapabilityBoundingSet= cannot traverse to reach the reopened paths (EACCES).
# @@NGINX_EXTRA_READ_PATHS@@ holds root/alias/include/ssl_* locations under a
# home dir that setup-service found in `nginx -T` outside the paths below.
ProtectHome=tmpfs
BindReadOnlyPaths=@@HOME_NGINX_CONF_DIR@@ @@CONF_DIR@@ @@NGINX_EXTRA_READ_PATHS@@
BindPaths=@@SCRATCH_DIR@@
# nginx's own temp dirs live under SCRATCH_DIR (-p), never the shared /tmp.
PrivateTmp=true
# The inherited 80/443 fds are already open before exec and unaffected by
# this; it only blocks the worker opening *new* sockets in other families
# (netlink, packet, …) it has no legitimate use for.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Fds are inherited pre-opened from the socket; the worker needs no
# capabilities of its own.
CapabilityBoundingSet=
# Systemd / process logs (nginx access/error also under @@SCRATCH_DIR@@/logs/).
# Follow with: tail --follow=name --retry @@SCRATCH_DIR@@/home-warden.log
StandardOutput=append:@@SCRATCH_DIR@@/home-warden.log
StandardError=append:@@SCRATCH_DIR@@/home-warden.log

[Install]
WantedBy=multi-user.target
