[Unit]
Description=home-warden nginx sockets (80/443)
Documentation=https://github.com/the-hcma/home-warden/blob/main/docs/architecture-socket-activation.md

[Socket]
# IPv4 sockets are fds 3 and 4 (NGINX=3:4;). setup-service adds an IPv6-only
# [::]:80 / [::]:443 socket, and extends NGINX=, through generated drop-ins
# for each `listen [::]:…` the served conf declares (#156).
ListenStream=0.0.0.0:80
ListenStream=0.0.0.0:443
FreeBind=true
Accept=no

[Install]
WantedBy=sockets.target
