# Oneshot: zones.yml syntax check, pdns_control reload, then the recursor's
# reload-zones and per-zone probes (#127).
# Template: etc/systemd/home-warden-pdns-reload.service — same
# @@PLACEHOLDER@@ convention as this repo's other unit templates.
# Installed/enabled by scripts/setup-service, opt-in via PDNS_ZONES_YAML --
# see docs/dns-tinydns-migration.md.
# No [Install] — activated only by home-warden-pdns-reload.path.

[Unit]
Description=home-warden pdns zones.yml check, reload and recursor probe (oneshot)
Documentation=https://github.com/the-hcma/home-warden/blob/main/docs/dns-tinydns-migration.md

[Service]
Type=oneshot
# Needs root for pdns_control and rec_control (control sockets owned by the
# pdns system account the distro packages already create) /
# systemctl is-active. No User=, so %h isn't the operator's home — HOME
# must be set explicitly so scripts/lib/host-guard (sourced by
# scripts/pdns-test-and-reload) can find the pin under the operator's
# ~/.config, not /root/.config.
Environment=HOME=@@HOME_DIR@@
# scripts/pdns-test-and-reload runs its uv-backed syntax gate as OWNER (via
# runuser, so nothing root-owned lands in OWNER's uv cache or .venv), then
# pdns_control as root. @@HOME_DIR@@/.local/bin first: the astral.sh uv
# installer's default per-user location, as in home-warden-catalog-heal.service.
Environment=OWNER=@@OWNER@@
Environment=PDNS_ZONES_YAML=@@PDNS_ZONES_YAML@@
Environment=PATH=@@HOME_DIR@@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@REPO_DIR@@/scripts/pdns-test-and-reload
TimeoutStartSec=2min
StandardOutput=append:@@SCRATCH_DIR@@/pdns-test-and-reload.log
StandardError=append:@@SCRATCH_DIR@@/pdns-test-and-reload.log
