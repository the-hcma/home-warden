#!/usr/bin/env bash
# Probe home-warden nginx health; email on failure / recovery / periodic re-alert.
#
# Env (override via ~/.config/home-warden-healthcheck.env):
#   HEALTHCHECK_EMAIL_TO     required for mail (no default — set locally)
#   HEALTHCHECK_EMAIL_FROM   default: home-warden@$(hostname -f)
#   HEALTHCHECK_HOST         default: app.example.com (SNI / Host for local probe)
#   HEALTHCHECK_URL_PATH     default: /
#   HEALTHCHECK_TIMEOUT_SEC  default: 5 (whole HTTPS probe)
#   HEALTHCHECK_CONNECT_TIMEOUT_SEC  default: 3 (TCP + TLS handshake to 127.0.0.1)
#   HEALTHCHECK_OK_STATUSES  default: 200,204,301,302,303,307,308
#   HEALTHCHECK_RESEND_SEC   default: 1800 (re-alert while still failing)
#   HEALTHCHECK_SERVICE      default: home-warden.service
#   HEALTHCHECK_SOCKET       default: home-warden.socket
#   SCRATCH_DIR              default: ~/scratch/home-warden
#
# The service is socket-activated: after a boot (or when idle) home-warden.service can be inactive while
# home-warden.socket listens, and the first connection starts it. That is not a failure; the probe below is
# that first connection. It fails only when the socket is not listening, the service failed, or HTTPS does not answer.
#
# Exit: always 0 when run from the timer (email is the alarm). Use --check-only
# to exit 1 on unhealthy for manual / CI probing (no mail, no state writes).
#
# Usage:
#   ./scripts/healthcheck
#   ./scripts/healthcheck --verbose
#   ./scripts/healthcheck --check-only
#
# Refuses to probe/alert anywhere but the host pinned by
# `scripts/setup-service --confirm-host` (see scripts/lib/host-guard).

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck source=scripts/lib/host-guard
source "${script_dir}/lib/host-guard"

scratch_dir="${SCRATCH_DIR:-${HOME}/scratch/home-warden}"
email_to="${HEALTHCHECK_EMAIL_TO:-}"
email_from="${HEALTHCHECK_EMAIL_FROM:-}"
probe_host="${HEALTHCHECK_HOST:-app.example.com}"
url_path="${HEALTHCHECK_URL_PATH:-/}"
timeout_sec="${HEALTHCHECK_TIMEOUT_SEC:-5}"
connect_timeout_sec="${HEALTHCHECK_CONNECT_TIMEOUT_SEC:-3}"
ok_statuses="${HEALTHCHECK_OK_STATUSES:-200,204,301,302,303,307,308}"
resend_sec="${HEALTHCHECK_RESEND_SEC:-1800}"
service_name="${HEALTHCHECK_SERVICE:-home-warden.service}"
socket_name="${HEALTHCHECK_SOCKET:-home-warden.socket}"
state_file="${scratch_dir}/healthcheck.state"
log_file="${scratch_dir}/healthcheck.log"

verbose=0
check_only=0

usage() {
  cat <<'EOF'
Usage: healthcheck [--verbose] [--check-only] [-h|--help]

Probe home-warden.service + local HTTPS; email on fail/recovery (see env).
  --check-only   Exit 1 when unhealthy (no email, no state writes)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose | -v) verbose=1 ;;
    --check-only) check_only=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! hw_host_guard_enforce "healthcheck"; then
  if ((check_only)); then
    exit 1
  fi
  exit 0
fi

if [[ -z "${email_from}" ]]; then
  host_f="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo localhost)"
  email_from="home-warden@${host_f}"
fi

if [[ ! "${resend_sec}" =~ ^[0-9]+$ ]]; then
  resend_sec=1800
fi

mkdir -p "${scratch_dir}"
: >>"${log_file}" 2>/dev/null || true

# When run under systemd StandardOutput=append, avoid tee duplication.
log_out() {
  local msg=$1
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ) ($(date '+%-I:%M:%S %p %Z'))"
  if [[ -n "${INVOCATION_ID:-}" ]]; then
    printf '%s %s\n' "${ts}" "${msg}"
  elif ((verbose)); then
    printf '%s %s\n' "${ts}" "${msg}" | tee -a "${log_file}"
  else
    printf '%s %s\n' "${ts}" "${msg}" >>"${log_file}"
  fi
}

# "7:12 AM EST, Nov 28 (12:12 UTC Nov 28)": local time first, UTC in parentheses.
fmt_time() {
  local epoch=$1
  printf '%s (%s)' "$(date -d "@${epoch}" '+%-I:%M %p %Z, %b %-d' 2>/dev/null || date -r "${epoch}" '+%-I:%M %p %Z, %b %-d')" \
    "$(date -u -d "@${epoch}" '+%H:%M UTC %b %-d' 2>/dev/null || date -u -r "${epoch}" '+%H:%M UTC %b %-d')"
}

fmt_duration() {
  local sec=$1
  if ((sec < 90)); then
    printf '%ss' "${sec}"
  elif ((sec < 5400)); then
    printf '%s min' "$(((sec + 30) / 60))"
  else
    printf '%sh %smin' "$((sec / 3600))" "$(((sec % 3600) / 60))"
  fi
}

status_ok() {
  local code=$1
  local s
  IFS=',' read -r -a arr <<<"${ok_statuses}"
  for s in "${arr[@]}"; do
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    [[ "${code}" == "${s}" ]] && return 0
  done
  return 1
}

idle_start=0

probe() {
  # Sets nameref: ok (0/1), detail (string); idle_start=1 when the socket was up and the service idle
  local -n _ok=$1
  local -n _detail=$2
  _ok=1
  _detail=""

  local svc_state sock_state
  idle_start=0
  if ! systemctl is-active --quiet "${service_name}" 2>/dev/null; then
    svc_state="$(systemctl is-active "${service_name}" 2>/dev/null || true)"
    if systemctl is-active --quiet "${socket_name}" 2>/dev/null; then
      sock_state="active"
    else
      sock_state="$(systemctl is-active "${socket_name}" 2>/dev/null || true)"
    fi
    if [[ "${svc_state}" == "failed" ]]; then
      _ok=0
      _detail="${service_name} has failed (check: journalctl -u ${service_name} -n 50)"
      return 0
    fi
    if [[ "${sock_state}" != "active" ]]; then
      _ok=0
      _detail="${service_name} is ${svc_state:-unknown} and ${socket_name} is ${sock_state:-unknown}: nothing is listening on ports 80 and 443 (check: systemctl status ${socket_name})"
      return 0
    fi
    # Socket listening, service idle: normal after a boot (the first connection starts it). The probe below is that connection.
    idle_start=1
  fi

  if ! command -v curl >/dev/null 2>&1; then
    _ok=0
    _detail="curl not found on PATH"
    return 0
  fi

  local url="https://${probe_host}${url_path}"
  local code err
  err="$(mktemp)"
  code="$(
    curl -sS --connect-timeout "${connect_timeout_sec}" --max-time "${timeout_sec}" \
      --resolve "${probe_host}:443:127.0.0.1" \
      -o /dev/null -w '%{http_code}' \
      "${url}" 2>"${err}" || true
  )"
  if [[ -z "${code}" || "${code}" == "000" ]]; then
    _ok=0
    _detail="HTTPS probe failed for ${url} via 127.0.0.1: $(tr '\n' ' ' <"${err}" | sed 's/[[:space:]]\+/ /g')"
    rm -f "${err}"
    return 0
  fi
  rm -f "${err}"
  if ! status_ok "${code}"; then
    _ok=0
    _detail="HTTPS ${url} returned HTTP ${code} (ok statuses: ${ok_statuses})"
    return 0
  fi
  _detail="ok service=${service_name} https=${url} status=${code}"
  if ((idle_start)); then
    _detail="${_detail} (the service was idle, waiting for its first connection; this probe started it)"
  fi
  return 0
}

# Parse KEY=VALUE lines; never source the state file.
read_state() {
  local -n _ps=$1
  local -n _la=$2
  local -n _ff=$3
  local -n _fd=$4
  local line key val
  _ps="unknown"
  _la=0
  _ff=0
  _fd=""
  [[ -f "${state_file}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line}" ]] && continue
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "${key}" in
      status)
        case "${val}" in
          ok | fail | unknown) _ps="${val}" ;;
        esac
        ;;
      last_alert_epoch)
        if [[ "${val}" =~ ^[0-9]+$ ]]; then
          _la="${val}"
        fi
        ;;
      first_fail_epoch)
        if [[ "${val}" =~ ^[0-9]+$ ]]; then
          _ff="${val}"
        fi
        ;;
      fail_detail)
        _fd="${val}"
        ;;
    esac
  done <"${state_file}"
}

write_state() {
  local st=$1
  local la=$2
  local detail=$3
  local ff=${4:-0}
  local fd=${5:-}
  local tmp
  umask 077
  tmp="$(mktemp "${scratch_dir}/healthcheck.state.XXXXXX")"
  # detail is log-only context; keep state machine fields strict/simple
  {
    printf 'status=%s\n' "${st}"
    printf 'last_alert_epoch=%s\n' "${la}"
    printf 'first_fail_epoch=%s\n' "${ff}"
    printf 'fail_detail=%s\n' "$(printf '%s' "${fd}" | tr '\n\r' '  ')"
    printf '# last_detail=%s\n' "${detail}"
  } >"${tmp}"
  mv -f "${tmp}" "${state_file}"
}

send_mail() {
  local subject=$1
  local body=$2
  if [[ -z "${email_to}" ]]; then
    log_out "WARN: HEALTHCHECK_EMAIL_TO unset — skip mail: ${subject}"
    return 0
  fi
  if command -v sendmail >/dev/null 2>&1; then
    sendmail -t <<EOF
From: ${email_from}
To: ${email_to}
Subject: ${subject}
Content-Type: text/plain; charset=UTF-8

${body}
EOF
    return 0
  fi
  if command -v mail >/dev/null 2>&1; then
    printf '%s\n' "${body}" | mail -s "${subject}" -r "${email_from}" "${email_to}"
    return 0
  fi
  log_out "ERROR: neither sendmail nor mail found — cannot send: ${subject}"
  return 1
}

now_epoch="$(date +%s)"
healthy=1
detail=""
probe healthy detail

prev_status="unknown"
last_alert=0
first_fail=0
first_fail_detail=""
read_state prev_status last_alert first_fail first_fail_detail
if [[ ! "${last_alert}" =~ ^[0-9]+$ ]]; then
  last_alert=0
fi
if [[ ! "${first_fail}" =~ ^[0-9]+$ ]]; then
  first_fail=0
fi

host_short="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)"
subject_prefix="[home-warden ${host_short}]"

if ((healthy)); then
  log_out "OK ${detail}"
  if ((check_only)); then
    exit 0
  fi
  if [[ "${prev_status}" == "fail" ]]; then
    down_for=""
    since_line="It was unhealthy since an earlier check; the start time was not recorded."
    if ((first_fail > 0)); then
      down_for="$((now_epoch - first_fail))"
      since_line="Unhealthy from $(fmt_time "${first_fail}") to $(fmt_time "${now_epoch}"), about $(fmt_duration "${down_for}")."
    fi
    send_mail "${subject_prefix} RECOVERED" \
      "home-warden on ${host_short} is healthy again.

${since_line}
What was wrong: ${first_fail_detail:-not recorded}
Now: ${detail}
"
    write_state "ok" "${now_epoch}" "${detail}"
  else
    write_state "ok" "${last_alert}" "${detail}"
  fi
  exit 0
fi

log_out "FAIL ${detail}"
if ((check_only)); then
  exit 1
fi

# The first failure of an outage starts the clock; later failures keep it and the first reason.
if [[ "${prev_status}" != "fail" || "${first_fail}" -le 0 ]]; then
  first_fail="${now_epoch}"
  first_fail_detail="${detail}"
fi

should_alert=0
if [[ "${prev_status}" != "fail" ]]; then
  should_alert=1
elif ((now_epoch - last_alert >= resend_sec)); then
  should_alert=1
fi

if ((should_alert)); then
  failing_line="First failed check: $(fmt_time "${first_fail}")."
  if ((now_epoch - first_fail >= 60)); then
    failing_line="Failing since $(fmt_time "${first_fail}"), for $(fmt_duration "$((now_epoch - first_fail))")."
  fi
  send_mail "${subject_prefix} UNHEALTHY" \
    "home-warden on ${host_short} failed its health check at $(fmt_time "${now_epoch}").

${failing_line}

Why: ${detail}

Check: systemctl status ${service_name} ${socket_name}
       journalctl -u ${service_name} -n 50
       ${script_dir}/healthcheck --verbose --check-only

You get a mail when this changes, and another every ${resend_sec}s while it keeps failing.
"
  write_state "fail" "${now_epoch}" "${detail}" "${first_fail}" "${first_fail_detail}"
else
  write_state "fail" "${last_alert}" "${detail}" "${first_fail}" "${first_fail_detail}"
fi
exit 0
