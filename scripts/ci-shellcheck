#!/usr/bin/env bash
# Local/CI helper: bash -n + shellcheck -S info for all bash scripts under scripts/.
# Filters by shebang (not just "executable") so a non-bash script (e.g. a
# Python entry point, also extension-less per convention) isn't misread as bash.
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_dir}"

scripts=()
shebang=""
file=""
while IFS= read -r -d '' file; do
  [[ "$(basename "${file}")" == "ci-shellcheck" ]] && continue
  read -r shebang <"${file}" || shebang=""
  [[ "${shebang}" == "#!/usr/bin/env bash" ]] && scripts+=("${file}")
done < <(find scripts -type f -executable -print0 | sort -z)

if [[ ${#scripts[@]} -eq 0 ]]; then
  echo "No executable bash scripts under scripts/" >&2
  exit 1
fi
bash -n "${scripts[@]}"
shellcheck -S info "${scripts[@]}"
echo "shellcheck OK (${#scripts[@]} scripts)"
