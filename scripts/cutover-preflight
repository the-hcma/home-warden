#!/usr/bin/env bash
# Read-only readiness check for a host taking over the front door. Thin wrapper around the
# app.cutover_preflight_cli console script -- see that module's docstring for usage/exit codes.
# See the-hcma/home-warden#187.
#
# Usage:
#   ./scripts/cutover-preflight [--skip-certbot-dry-run] [--no-sudo]

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_dir}"

if ! command -v uv >/dev/null 2>&1; then
  echo "cutover-preflight: install uv (https://docs.astral.sh/uv/) or run 'uv sync' in ${repo_dir}" >&2
  exit 1
fi

exec uv run cutover-preflight "$@"
