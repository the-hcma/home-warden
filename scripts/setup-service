#!/usr/bin/env bash
# Install home-warden system socket + service (privileged ports via systemd).
# Expands etc/systemd templates into /etc/systemd/system/ with sudo.
#
# Placeholders: @@OWNER@@ @@SCRATCH_DIR@@ @@CONF_DIR@@ @@HOME_NGINX_CONF@@ @@HOME_DIR@@
#               @@PDNS_ZONES_YAML@@ @@PDNS_ZONES_YAML_DIR@@ @@SERVICES_JSON_PATH@@
#               @@NGINX_EXTRA_READ_PATHS@@ @@SERVICE_USER@@ @@SERVICE_GROUP@@
# Injects ConditionHost=|<machine-id> and ConditionHost=|<hostname> (OR).
#
# Flow (non-dry-run):
#   1. Confirm / verify the designated host (see scripts/lib/host-guard)
#   2. Prompt for sudo (credential cache)
#   3. Verify packages / home nginx.conf / unit templates
#   4. Prepare scratch runtime (logs, modules symlink)
#   5. Validate nginx config (sudo nginx -t) — abort if invalid
#   6. Run on-deploy (when present), install units, mask distro nginx, start service
#
# Usage:
#   ./scripts/setup-service [--status] [--dry-run]
#   ./scripts/setup-service --confirm-host   # first-time pin, non-interactive
#   ./scripts/setup-service --repin-host     # move the pin to this host
#   HOME_NGINX_CONF=/path/to/home/nginx/server/nginx.conf ./scripts/setup-service
#   PDNS_ZONES_YAML=/path/to/home/dns/zones.yml ./scripts/setup-service
#   SERVICES_JSON_PATH=/path/to/services.json ./scripts/setup-service
#
# Env overrides:
#   HOME_NGINX_CONF     Absolute path to thehcma/home nginx.conf
#   PDNS_ZONES_YAML     Absolute path to thehcma/home dns/zones.yml — opt-in:
#                       enables the pdns reload-on-edit path unit (see
#                       docs/dns-tinydns-migration.md, #108) when set or when
#                       the default path below exists; skipped otherwise
#   SERVICES_JSON_PATH  Absolute path to the service catalog — opt-in:
#                       enables the catalog-heal timer (see AGENTS.md's
#                       Catalog Auto-Healing section, #57) when set or when
#                       the default path below exists; skipped otherwise
#   OWNER               Operator account that owns the repo, conf, certs and
#                       scratch, and runs the certbot/healthcheck units
#                       (default: current user)
#   SERVICE_USER        Account home-warden.service (nginx) runs as
#                       (default: home-warden, created as a system account;
#                       set to OWNER to roll back to the operator's own uid)
#   SERVICE_GROUP       Group granted cert read + nginx scratch write
#                       (default: SERVICE_USER)
#   SCRATCH_DIR         Runtime prefix for nginx -p (default: ~/scratch/home-warden)
#   CONF_DIR            Durable SSL material (default: ~/conf/home-warden)
#   XDG_CONFIG_HOME     Base dir for ~/.config-style files (default: ~/.config)

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_dir="$(cd "${script_dir}/.." && pwd)"
readonly repo_dir
readonly unit_template_dir="${repo_dir}/etc/systemd"
readonly system_unit_dir="/etc/systemd/system"
readonly logrotate_template="${repo_dir}/etc/logrotate/home-warden"
readonly logrotate_dest="/etc/logrotate.d/home-warden"
readonly preview_dir_name="web-ui-preview"
readonly sudoers_template="${repo_dir}/etc/sudoers/home-warden-web-ui-nginx-test"
readonly sudoers_dest="/etc/sudoers.d/home-warden-web-ui-nginx-test"
readonly pdns_dropin_dest="/etc/systemd/system/pdns.service.d/home-warden.conf"
readonly installed_host_guard_dir="/usr/local/libexec/home-warden"
readonly installed_host_guard="${installed_host_guard_dir}/host-guard"
readonly resolved_dropin_dest="/etc/systemd/resolved.conf.d/home-warden-local-zones.conf"
readonly preview_conf_path_dir="/usr/local/etc"
readonly preview_conf_path_dest="${preview_conf_path_dir}/home-warden-preview-conf-path"
readonly home_warden_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/home-warden"
readonly home_warden_config_path="${home_warden_config_dir}/config.toml"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/host-guard
source "${script_dir}/lib/host-guard"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/nginx-pid
source "${script_dir}/lib/nginx-pid"

owner="${OWNER:-$(id -un)}"
service_user="${SERVICE_USER:-home-warden}"
service_group="${SERVICE_GROUP:-${service_user}}"
scratch_dir="${SCRATCH_DIR:-${HOME}/scratch/home-warden}"
conf_dir="${CONF_DIR:-${HOME}/conf/home-warden}"
home_nginx_conf="${HOME_NGINX_CONF:-}"
pdns_zones_yaml="${PDNS_ZONES_YAML:-}"
pdns_enabled=0
pdns_dropin_changed=0
host_resolver_mode="${PDNS_HOST_RESOLVER:-}"
readonly host_resolver_mode
recursor_address="${PDNS_RECURSOR_ADDRESS:-127.0.0.1}"
readonly recursor_address
resolved_dropin_changed=0
services_json="${SERVICES_JSON_PATH:-}"
catalog_heal_enabled=0
deployed_commit="${DEPLOYED_COMMIT:-}"
nginx_dump=""
nginx_extra_read_paths=""
owner_home="$(getent passwd "${owner}" | cut -d: -f6 || true)"
readonly owner_home
preview_conf="${scratch_dir}/${preview_dir_name}/nginx.conf"
readonly preview_conf
preview_helper_dest="/usr/local/sbin/home-warden-nginx-test-candidate"
readonly preview_helper_dest
preview_helper_source="${repo_dir}/scripts/nginx-test-candidate"
readonly preview_helper_source
readonly default_home_nginx_conf="${HOME}/home/nginx/server/nginx.conf"
readonly default_pdns_zones_yaml="${HOME}/home/dns/zones.yml"
readonly default_services_json="${HOME}/.config/home-warden/services.json"
# nginx directives whose argument is a filesystem path the sandbox may need.
readonly -a nginx_path_directives=(
  alias
  auth_basic_user_file
  include
  root
  ssl_certificate
  ssl_certificate_key
  ssl_client_certificate
  ssl_crl
  ssl_dhparam
  ssl_password_file
  ssl_trusted_certificate
)

confirm_host=0
dry_run=0
repin_host=0
status_only=0

usage() {
  cat <<'EOF'
Usage: setup-service [--status] [--dry-run] [--confirm-host] [--repin-host] [-h|--help]

Install/enable home-warden.socket + home-warden.service into /etc/systemd/system,
plus certbot timer, conf-watch path unit, and healthcheck timer. Also installs
the pdns zones.yml reload-on-edit path unit when PDNS_ZONES_YAML is set (or
its default path exists) — skipped otherwise; see #108. Also installs the
catalog-heal timer when SERVICES_JSON_PATH is set (or its default path
exists) — skipped otherwise; see #57. With pdns wiring on, PDNS_HOST_RESOLVER=1
routes every zones.yml zone to the local recursor via a systemd-resolved
drop-in, PDNS_HOST_RESOLVER=0 removes it, and unset leaves it as is; see #139.
Prompts for sudo, validates nginx -t, then starts the service when validation passes.

  --status        Show resolved paths and unit state; do not install
  --dry-run       Print actions without writing units or calling systemctl
  --confirm-host  Pin home-warden to this host non-interactively on first run
  --repin-host    Move an existing pin to this host (e.g. hardware replacement)

home-warden only ever acts on its one designated host (scripts/lib/host-guard).
On first run (interactive), you will be asked to confirm this host by name.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status) status_only=1 ;;
    --dry-run) dry_run=1 ;;
    --confirm-host) confirm_host=1 ;;
    --repin-host) repin_host=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -n "${host_resolver_mode}" && "${host_resolver_mode}" != "0" && "${host_resolver_mode}" != "1" ]]; then
  echo "ERROR: PDNS_HOST_RESOLVER must be 1, 0 or unset (got '${host_resolver_mode}')" >&2
  exit 2
fi

ensure_host_config() {
  mkdir -p "${hw_host_guard_config_dir}"

  # A pin mismatch always refuses — dry-run must surface this real blocker too.
  if hw_is_pinned && ! hw_matches_pinned_host && ((repin_host == 0)); then
    echo "ERROR: home-warden is pinned to a different host (see ${hw_pinned_host_file})" >&2
    echo "  this host: $(hw_current_hostname_short) (machine-id $(hw_current_machine_id))" >&2
    echo "  re-run with --repin-host if you intend to move home-warden here" >&2
    exit 1
  fi

  if hw_is_pinned && hw_matches_pinned_host; then
    if ((dry_run)); then
      echo "DRY-RUN: host already pinned to $(hw_current_hostname_short)"
      return 0
    fi
  elif ((confirm_host == 0)); then
    if [[ -t 0 && -t 1 ]]; then
      if ((dry_run)); then
        echo "DRY-RUN: would prompt to confirm pinning to $(hw_current_hostname_short)"
        return 0
      fi
      local reply=""
      echo "home-warden has no designated host yet."
      echo "  This will pin it to: $(hw_current_hostname_short) ($(hostname))"
      read -r -p "Continue? [y/N] " reply
      case "${reply}" in
        y | Y | yes | YES) ;;
        *)
          echo "Aborted — nothing pinned." >&2
          exit 1
          ;;
      esac
    else
      # No confirmation possible — refuse in dry-run too; it must reflect the real outcome.
      echo "ERROR: home-warden has no designated host yet." >&2
      echo "  Verify 'hostname -s' is correct for this host, then re-run with --confirm-host." >&2
      exit 1
    fi
  else
    if ((dry_run)); then
      echo "DRY-RUN: would pin home-warden to this host ($(hw_current_hostname_short))"
      return 0
    fi
    echo "Pinning home-warden to this host ($(hw_current_hostname_short))..."
  fi

  hw_current_hostname_short >"${hw_pinned_host_file}"
  hw_current_machine_id >"${hw_pinned_machine_id_file}"
  hostname >"${hw_pinned_host_fqdn_file}" || hw_current_hostname_short >"${hw_pinned_host_fqdn_file}"
}

# home-warden.service runs as a dedicated system account (#43) so an nginx
# compromise is not a compromise of the operator's uid. OWNER joins the group
# so cert-renewer (running as OWNER) can hand renewed keys to it.
ensure_service_account() {
  if [[ "${service_user}" == "${owner}" ]]; then
    echo "SERVICE_USER=${owner}: home-warden.service keeps running as the operator (no dedicated account)"
    return 0
  fi
  if ! getent group "${service_group}" >/dev/null; then
    echo "Creating system group ${service_group}..."
    run sudo groupadd --system "${service_group}"
  fi
  if ! getent passwd "${service_user}" >/dev/null; then
    echo "Creating system account ${service_user}..."
    run sudo useradd --system --gid "${service_group}" --no-create-home \
      --home-dir /nonexistent --shell /usr/sbin/nologin "${service_user}"
  fi
  if ! id -nG "${owner}" | tr ' ' '\n' | grep -qx "${service_group}"; then
    echo "Adding ${owner} to group ${service_group}..."
    run sudo usermod --append --groups "${service_group}" "${owner}"
  fi
}

resolve_home_nginx_conf() {
  if [[ -n "${home_nginx_conf}" ]]; then
    printf '%s\n' "${home_nginx_conf}"
    return 0
  fi
  if [[ -f "${default_home_nginx_conf}" ]]; then
    printf '%s\n' "${default_home_nginx_conf}"
    return 0
  fi
  return 1
}

# home-warden.service runs with ProtectHome=tmpfs, so any file the served conf
# references under /home or /root is invisible unless bind-mounted back in.
# Prints one `-<path>` per line (the `-` makes systemd skip a path that has
# since disappeared instead of refusing to start) for every such location not
# already covered by HOME_NGINX_CONF's dir, CONF_DIR, or SCRATCH_DIR. File
# directives bind just the file; only root/alias and glob includes bind a
# directory. The whole argument up to `;` is captured so a path the allowlist
# can't take (e.g. a quoted one with a space) is warned about, never silently
# dropped. The conf is not trusted to widen the sandbox arbitrarily: see
# is_safe_sandbox_bind for what is refused.
resolve_nginx_extra_read_paths() {
  local -r dump="$1"
  local covered
  local directive
  local directive_re
  local home_nginx_conf_dir
  local path
  local skip
  local target

  directive_re="$(
    IFS='|'
    printf '%s' "${nginx_path_directives[*]}"
  )"
  home_nginx_conf_dir="$(dirname "${home_nginx_conf}")"
  while read -r directive path; do
    path="${path//\"/}"
    path="${path//\'/}"
    if [[ "${path}" != /home/* && "${path}" != /root/* ]] || [[ "${path}" == *'$'* ]]; then
      continue
    fi
    case "${directive}" in
      alias | root) target="${path%/}" ;;
      include)
        if [[ "${path}" == *[*?[]* ]]; then
          target="$(dirname "${path}")"
        else
          target="${path}"
        fi
        ;;
      *) target="${path}" ;;
    esac
    while [[ "${target}" == *//* ]]; do
      target="${target//\/\//\/}"
    done
    if [[ "${target}" != / ]]; then
      target="${target%/}"
    fi
    skip=0
    for covered in "${home_nginx_conf_dir}" "${conf_dir}" "${scratch_dir}"; do
      if [[ "${target}" == "${covered}" || "${target}" == "${covered}"/* ]]; then
        skip=1
      fi
    done
    if ((skip)); then
      continue
    fi
    if ! is_safe_sandbox_bind "${target}"; then
      echo "WARNING: not exposing ${target} (from ${directive}) to the nginx sandbox:" \
        "only plain paths below /home/<user>/ are allowed — move it under a dedicated dir" >&2
      continue
    fi
    printf -- '-%s\n' "${target}"
  done < <(
    sed -nE "s/^[[:space:]]*(${directive_re})[[:space:]]+([^;]+);.*\$/\1 \2/p" \
      <<<"${dump}"
  ) | sort -u
}

# Opt-in, unlike resolve_home_nginx_conf: pdns is not a required part of
# every home-warden install yet (see #108), so an unresolvable zones.yml
# is not an error here — callers treat return 1 as "skip pdns wiring".
resolve_pdns_zones_yaml() {
  if [[ -n "${pdns_zones_yaml}" ]]; then
    printf '%s\n' "${pdns_zones_yaml}"
    return 0
  fi
  if [[ -f "${default_pdns_zones_yaml}" ]]; then
    printf '%s\n' "${default_pdns_zones_yaml}"
    return 0
  fi
  return 1
}

# Opt-in like resolve_pdns_zones_yaml: not every host necessarily renders
# nginx from a services.json catalog (see #57's catalog-heal), so an
# unresolvable path is not an error here -- callers treat return 1 as "skip
# catalog-heal wiring".
resolve_services_json() {
  if [[ -n "${services_json}" ]]; then
    printf '%s\n' "${services_json}"
    return 0
  fi
  if [[ -f "${default_services_json}" ]]; then
    printf '%s\n' "${default_services_json}"
    return 0
  fi
  return 1
}

# Accepts only /home/<user>/<segment>[/<segment>...] (target already
# normalized) where every segment is plain [A-Za-z0-9._@+-] not starting with
# a dot. That refuses /root, /home, a bare home dir, hidden paths (~/.ssh,
# ~/.config, `..`), and any character (backslash, `&`, `|`, whitespace) that
# could escape the sed substitution expand_unit renders these into.
is_safe_sandbox_bind() {
  local -r target="$1"
  local -r segment='[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*'
  [[ "${target}" =~ ^/home/${segment}(/${segment})+$ ]]
}

is_valid_fqdn() {
  local -r fqdn="${1:-}"
  [[ "${fqdn}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

write_home_warden_config() {
  local -r fqdn="${1:-}"
  run mkdir -p "${home_warden_config_dir}"
  if ((dry_run)); then
    if [[ -n "${fqdn}" ]]; then
      echo "DRY-RUN: would write ${home_warden_config_path} with fqdn=${fqdn}"
    else
      echo "DRY-RUN: would write ${home_warden_config_path} with web UI disabled"
    fi
    return 0
  fi
  if [[ -n "${fqdn}" ]]; then
    cat >"${home_warden_config_path}" <<EOF
# home-warden web UI config.
# Set the HTTPS hostname nginx should serve the admin UI under.
fqdn = "${fqdn}"
EOF
  else
    cat >"${home_warden_config_path}" <<'EOF'
# home-warden web UI config.
# Leave fqdn empty to keep the admin UI disabled.
fqdn = ""
EOF
  fi
  chmod 600 "${home_warden_config_path}"
}

maybe_create_web_ui_config() {
  local fqdn=""
  if [[ -f "${home_warden_config_path}" ]]; then
    return 0
  fi
  if ((dry_run)); then
    if [[ -t 0 && -t 1 ]] && ((confirm_host == 0 && repin_host == 0)); then
      echo "DRY-RUN: would prompt for the web UI FQDN and write ${home_warden_config_path}"
    fi
    return 0
  fi
  if ! [[ -t 0 && -t 1 ]] || ((confirm_host)) || ((repin_host)); then
    return 0
  fi

  echo "Optional: configure the home-warden web UI hostname."
  echo "  Leave blank to keep the web UI disabled for now."
  while :; do
    read -r -p "Admin UI FQDN (blank to disable): " fqdn
    if [[ -z "${fqdn}" ]]; then
      write_home_warden_config ""
      echo "Created ${home_warden_config_path} with the web UI disabled."
      return 0
    fi
    if is_valid_fqdn "${fqdn}"; then
      write_home_warden_config "${fqdn}"
      echo "Created ${home_warden_config_path}."
      return 0
    fi
    echo "ERROR: enter a hostname like warden.example.com, or leave it blank to disable." >&2
  done
}

# pdns_has_access <path> <r|x> — whether the pdns account has that permission
# on <path>, applying the kernel's owner-then-group-then-other precedence.
pdns_has_access() {
  local -r target="$1"
  local -r bit="$2"
  local file_group
  local file_owner
  local group
  local -a pdns_groups=()

  file_owner="$(stat -c '%U' "${target}")"
  file_group="$(stat -c '%G' "${target}")"
  if [[ "${file_owner}" == "pdns" ]]; then
    [[ -n "$(find "${target}" -maxdepth 0 -perm "-u=${bit}")" ]]
    return
  fi
  read -r -a pdns_groups <<<"$(id -Gn pdns 2>/dev/null || true)"
  for group in "${pdns_groups[@]}"; do
    if [[ "${group}" == "${file_group}" ]]; then
      [[ -n "$(find "${target}" -maxdepth 0 -perm "-g=${bit}")" ]]
      return
    fi
  done
  [[ -n "$(find "${target}" -maxdepth 0 -perm "-o=${bit}")" ]]
}

run() {
  if ((dry_run)); then
    printf 'DRY-RUN:'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

require_sudo() {
  if ((dry_run)); then
    echo "DRY-RUN: would prompt for sudo credentials"
    return 0
  fi
  echo "Requesting sudo credentials (needed for units, nginx -t, and masking distro nginx)..."
  if ! sudo -v; then
    echo "ERROR: sudo authentication failed" >&2
    exit 1
  fi
}

package_installed() {
  local -r pkg="$1"
  dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -q 'install ok installed'
}

check_prerequisites() {
  local missing=0
  local pkg

  if [[ -z "${owner_home}" ]]; then
    echo "ERROR: could not resolve home directory for owner ${owner}" >&2
    missing=1
  fi
  if ! command -v nginx >/dev/null 2>&1; then
    echo "ERROR: nginx not on PATH — sudo apt-get install -y nginx libnginx-mod-stream" >&2
    missing=1
  fi
  for pkg in nginx libnginx-mod-stream; do
    if ! package_installed "${pkg}"; then
      echo "ERROR: package ${pkg} not installed — sudo apt-get install -y nginx libnginx-mod-stream" >&2
      missing=1
    fi
  done
  if ! command -v certbot >/dev/null 2>&1; then
    echo "ERROR: certbot not on PATH — sudo apt-get install -y certbot python3-certbot-dns-cloudflare" >&2
    missing=1
  fi
  for pkg in certbot python3-certbot-dns-cloudflare; do
    if ! package_installed "${pkg}"; then
      echo "ERROR: package ${pkg} not installed — sudo apt-get install -y certbot python3-certbot-dns-cloudflare" >&2
      missing=1
    fi
  done
  if [[ ! -f "${unit_template_dir}/home-warden.service" || ! -f "${unit_template_dir}/home-warden.socket" ]]; then
    echo "ERROR: missing unit templates under ${unit_template_dir}" >&2
    missing=1
  fi
  if [[ ! -f "${unit_template_dir}/home-warden-certbot.service" || ! -f "${unit_template_dir}/home-warden-certbot.timer" ]]; then
    echo "ERROR: missing certbot unit templates under ${unit_template_dir}" >&2
    missing=1
  fi
  if [[ ! -f "${unit_template_dir}/home-warden-reload.service" || ! -f "${unit_template_dir}/home-warden-reload.path" ]]; then
    echo "ERROR: missing reload path unit templates under ${unit_template_dir}" >&2
    missing=1
  fi
  if ((pdns_enabled)); then
    if [[ ! -f "${pdns_zones_yaml}" ]]; then
      echo "ERROR: PDNS_ZONES_YAML not found: ${pdns_zones_yaml}" >&2
      missing=1
    fi
    if [[ ! -f "${unit_template_dir}/home-warden-pdns-reload.service" || ! -f "${unit_template_dir}/home-warden-pdns-reload.path" ]]; then
      echo "ERROR: missing pdns reload unit templates under ${unit_template_dir}" >&2
      missing=1
    fi
    if [[ ! -x "${repo_dir}/scripts/pdns-test-and-reload" ]]; then
      echo "ERROR: scripts/pdns-test-and-reload missing or not executable" >&2
      missing=1
    fi
  fi
  if [[ ! -f "${unit_template_dir}/home-warden-healthcheck.service" || ! -f "${unit_template_dir}/home-warden-healthcheck.timer" ]]; then
    echo "ERROR: missing healthcheck unit templates under ${unit_template_dir}" >&2
    missing=1
  fi
  if ((catalog_heal_enabled)); then
    if [[ ! -f "${services_json}" ]]; then
      echo "ERROR: SERVICES_JSON_PATH not found: ${services_json}" >&2
      missing=1
    fi
    if [[ ! -f "${unit_template_dir}/home-warden-catalog-heal.service" || ! -f "${unit_template_dir}/home-warden-catalog-heal.timer" ]]; then
      echo "ERROR: missing catalog-heal unit templates under ${unit_template_dir}" >&2
      missing=1
    fi
    if [[ ! -x "${repo_dir}/scripts/catalog-heal" ]]; then
      echo "ERROR: scripts/catalog-heal missing or not executable" >&2
      missing=1
    fi
  fi
  if ! command -v logrotate >/dev/null 2>&1; then
    echo "ERROR: logrotate not on PATH — sudo apt-get install -y logrotate" >&2
    missing=1
  fi
  if [[ ! -f "${logrotate_template}" ]]; then
    echo "ERROR: missing logrotate template ${logrotate_template}" >&2
    missing=1
  fi
  if [[ ! -f "${sudoers_template}" ]]; then
    echo "ERROR: missing sudoers template ${sudoers_template}" >&2
    missing=1
  fi
  if ! command -v visudo >/dev/null 2>&1; then
    echo "ERROR: visudo not on PATH — install sudo" >&2
    missing=1
  fi
  if [[ ! -x "${repo_dir}/scripts/nginx-test-and-reload" ]]; then
    echo "ERROR: scripts/nginx-test-and-reload missing or not executable" >&2
    missing=1
  fi
  if [[ ! -x "${preview_helper_source}" ]]; then
    echo "ERROR: ${preview_helper_source} missing or not executable" >&2
    missing=1
  fi
  if [[ ! -x "${repo_dir}/scripts/healthcheck" ]]; then
    echo "ERROR: scripts/healthcheck missing or not executable" >&2
    missing=1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "ERROR: curl not on PATH — sudo apt-get install -y curl" >&2
    missing=1
  fi
  if [[ ! -f "${home_nginx_conf}" ]]; then
    echo "ERROR: HOME_NGINX_CONF not found: ${home_nginx_conf}" >&2
    missing=1
  fi
  if ((missing)); then
    exit 1
  fi
  echo "Prerequisites OK (nginx + certbot + curl + conf + unit templates + preview helper)"
}

prepare_scratch() {
  run mkdir -p \
    "${scratch_dir}/logs" \
    "${scratch_dir}/logs/certbot" \
    "${scratch_dir}/certbot-work" \
    "${scratch_dir}/client_body_temp" \
    "${scratch_dir}/proxy_temp" \
    "${scratch_dir}/fastcgi_temp" \
    "${scratch_dir}/uwsgi_temp" \
    "${scratch_dir}/scgi_temp" \
    "${scratch_dir}/${preview_dir_name}" \
    "${conf_dir}/certs/live"
  if [[ -d /usr/lib/nginx/modules ]]; then
    run ln -sfn /usr/lib/nginx/modules "${scratch_dir}/modules"
  fi
  if ((dry_run)); then
    echo "DRY-RUN: would touch ${scratch_dir}/{home-warden,cert-renewer,nginx-test-and-reload,healthcheck,catalog-heal}.log and logs/{error,access}.log"
  else
    local log
    for log in \
      "${scratch_dir}/home-warden.log" \
      "${scratch_dir}/cert-renewer.log" \
      "${scratch_dir}/nginx-test-and-reload.log" \
      "${scratch_dir}/healthcheck.log" \
      "${scratch_dir}/catalog-heal.log" \
      "${scratch_dir}/logs/error.log" \
      "${scratch_dir}/logs/access.log"; do
      if ! touch "${log}"; then
        echo "ERROR: cannot create log file ${log} (is SCRATCH_DIR writable?)" >&2
        exit 1
      fi
    done
  fi
}

validate_nginx_config() {
  # -t still opens the conf's `pid` path (logs/nginx.pid, same file the live
  # service writes) for writing even though it never starts workers. The conf
  # already declares its own `pid` directive, so overriding it via -g fails
  # with "duplicate" — instead let -t run, then hand the pid file back to
  # OWNER (scripts/lib/nginx-pid) so it doesn't leave the unprivileged
  # home-warden.service unable to write its own pid on the next start.
  # -T is -t plus a dump of the effective config (includes expanded), which
  # resolve_nginx_extra_read_paths scans for paths the sandbox must expose.
  echo "Validating nginx config (sudo nginx -T)..."
  if ((dry_run)); then
    echo "DRY-RUN: sudo nginx -p ${scratch_dir}/ -T -c ${home_nginx_conf}"
    return 0
  fi
  if ! nginx_dump="$(sudo nginx -p "${scratch_dir}/" -T -c "${home_nginx_conf}")"; then
    echo "ERROR: nginx -t failed — refusing to install/start home-warden" >&2
    exit 1
  fi
  hw_fix_nginx_pid_ownership "${scratch_dir}" "${owner}" "${service_group}"
  echo "nginx -t OK"
}

expand_unit() {
  local -r src="$1"
  local -r dest="$2"
  local generated
  local host_name
  local machine_id
  local tmp
  local home_nginx_conf_dir
  local pdns_zones_yaml_dir

  home_nginx_conf_dir="$(dirname "${home_nginx_conf}")"
  pdns_zones_yaml_dir="$(dirname "${pdns_zones_yaml}")"
  host_name="$(hw_first_line "${hw_pinned_host_file}")"
  machine_id="$(hw_first_line "${hw_pinned_machine_id_file}")"

  generated="$(
    sed \
      -e "s|@@OWNER@@|${owner}|g" \
      -e "s|@@SCRATCH_DIR@@|${scratch_dir}|g" \
      -e "s|@@CONF_DIR@@|${conf_dir}|g" \
      -e "s|@@HOME_NGINX_CONF@@|${home_nginx_conf}|g" \
      -e "s|@@HOME_NGINX_CONF_DIR@@|${home_nginx_conf_dir}|g" \
      -e "s|@@PDNS_ZONES_YAML@@|${pdns_zones_yaml}|g" \
      -e "s|@@PDNS_ZONES_YAML_DIR@@|${pdns_zones_yaml_dir}|g" \
      -e "s|@@SERVICES_JSON_PATH@@|${services_json}|g" \
      -e "s|@@REPO_DIR@@|${repo_dir}|g" \
      -e "s|@@HOME_DIR@@|${HOME}|g" \
      -e "s|@@DEPLOYED_COMMIT@@|${deployed_commit}|g" \
      -e "s|@@NGINX_EXTRA_READ_PATHS@@|${nginx_extra_read_paths}|g" \
      -e "s|@@SERVICE_USER@@|${service_user}|g" \
      -e "s|@@SERVICE_GROUP@@|${service_group}|g" \
      "${src}"
  )"

  generated="$(
    awk -v mid="${machine_id}" -v host="${host_name}" '
      BEGIN { done = 0 }
      /^\[Unit\]$/ && !done {
        print
        print "# Service host guard (OR): machine-id or hostname"
        # Adjacent string+var concatenates (no OFS space); | prefixes OR-group.
        printf "ConditionHost=|%s\n", mid
        printf "ConditionHost=|%s\n", host
        done = 1
        next
      }
      { print }
    ' <<<"${generated}"
  )"

  if ((dry_run)); then
    echo "DRY-RUN: would write ${dest}"
    echo "-----"
    printf '%s\n' "${generated}"
    echo "-----"
    return 0
  fi

  tmp="$(mktemp)"
  printf '%s\n' "${generated}" >"${tmp}"
  run sudo install -o root -g root -m 644 "${tmp}" "${dest}"
  rm -f "${tmp}"
}

# Everything stays owned by OWNER; SERVICE_GROUP gets read on the cert
# lineages (never certs/accounts/, which holds the ACME account key) and
# write on exactly the scratch paths nginx itself writes.
grant_service_access() {
  local -a cert_paths=()
  local -a writable_dirs=()
  local -a writable_files=()
  local path

  if [[ "${service_user}" == "${owner}" ]]; then
    return 0
  fi
  echo "Granting ${service_group} cert read + nginx scratch write..."
  for path in "${conf_dir}/certs/archive" "${conf_dir}/certs/live"; do
    if [[ -d "${path}" ]]; then
      cert_paths+=("${path}")
    fi
  done
  # The unit bind-mounts CONF_DIR/SCRATCH_DIR, exposing their own modes; a
  # 027 umask leaves them 750 OWNER:OWNER, so grant search (not listing).
  run sudo chgrp "${service_group}" "${conf_dir}" "${scratch_dir}"
  run sudo chmod g+x "${conf_dir}" "${scratch_dir}"
  run sudo chgrp "${service_group}" "${conf_dir}/certs"
  run sudo chmod g+rx "${conf_dir}/certs"
  if ((${#cert_paths[@]})); then
    run sudo chgrp -R "${service_group}" "${cert_paths[@]}"
    run sudo chmod -R g+rX,o-rwx "${cert_paths[@]}"
  fi

  for path in logs client_body_temp fastcgi_temp proxy_temp scgi_temp uwsgi_temp; do
    writable_dirs+=("${scratch_dir}/${path}")
  done
  for path in logs/access.log logs/error.log logs/nginx.pid; do
    if [[ -e "${scratch_dir}/${path}" ]] || ((dry_run)); then
      writable_files+=("${scratch_dir}/${path}")
    fi
  done
  run sudo chgrp "${service_group}" "${writable_dirs[@]}" "${writable_files[@]}"
  run sudo chmod g+rwxs "${writable_dirs[@]}"
  run sudo chmod g+rw "${writable_files[@]}"
}

install_preview_helper() {
  local rendered
  local tmp

  rendered="$(
    sed \
      -e "s|@@OWNER_HOME@@|${owner_home}|g" \
      -e "s|@@HOST_GUARD_LIB@@|${installed_host_guard}|g" \
      -e "s|@@PREVIEW_CONF_PATH_FILE@@|${preview_conf_path_dest}|g" \
      "${preview_helper_source}"
  )"

  if ((dry_run)); then
    echo "DRY-RUN: would write ${preview_helper_dest}"
    echo "-----"
    printf '%s\n' "${rendered}"
    echo "-----"
    return 0
  fi

  tmp="$(mktemp)"
  printf '%s\n' "${rendered}" >"${tmp}"
  run sudo install -o root -g root -m 755 "${tmp}" "${preview_helper_dest}"
  rm -f "${tmp}"
}

install_host_guard_library() {
  if ((dry_run)); then
    echo "DRY-RUN: would write ${installed_host_guard}"
    return 0
  fi

  run sudo install -d -o root -g root -m 755 "${installed_host_guard_dir}"
  run sudo install -o root -g root -m 644 "${script_dir}/lib/host-guard" "${installed_host_guard}"
}

# systemd-resolved sends everything to the DHCP-provided LAN resolvers, so a
# name that exists only in zones.yml never resolves on this host, including
# for nginx's proxy_pass (#139). Opt-in: route each zones.yml zone to the
# local recursor. Unset leaves an existing drop-in alone rather than removing
# host-wide DNS routing because a re-run forgot the variable.
install_host_resolver_dropin() {
  local current
  local generated
  local routing_domains=""
  local tmp
  local zone
  local zone_list
  local -a zones=()

  current="$(cat "${resolved_dropin_dest}" 2>/dev/null || true)"
  if [[ -z "${host_resolver_mode}" ]]; then
    if [[ -n "${current}" ]]; then
      echo "keeping ${resolved_dropin_dest} (PDNS_HOST_RESOLVER unset: 1 refreshes it, 0 removes it)"
    fi
    return 0
  fi
  if [[ "${host_resolver_mode}" == "0" ]]; then
    if [[ "${current}" == "# GENERATED by home-warden"* ]]; then
      resolved_dropin_changed=1
      run sudo rm -f "${resolved_dropin_dest}"
    fi
    return 0
  fi

  if ((!pdns_enabled)); then
    echo "ERROR: PDNS_HOST_RESOLVER=1 needs pdns wiring — set PDNS_ZONES_YAML (no zones.yml found)" >&2
    exit 1
  fi
  if ! systemctl is-active --quiet systemd-resolved.service; then
    echo "ERROR: PDNS_HOST_RESOLVER=1 needs an active systemd-resolved.service" >&2
    exit 1
  fi
  if ! systemctl is-active --quiet pdns-recursor.service; then
    echo "ERROR: PDNS_HOST_RESOLVER=1 routes zones to pdns-recursor.service, which is not active" >&2
    exit 1
  fi
  if ! zone_list="$("${script_dir}/dns-zones-yaml-check" --list-zones "${pdns_zones_yaml}")"; then
    echo "ERROR: cannot list the zones in ${pdns_zones_yaml} for the host resolver drop-in" >&2
    exit 1
  fi
  readarray -t zones <<<"${zone_list}"
  for zone in "${zones[@]}"; do
    routing_domains+=" ~${zone}"
  done

  generated="$(printf '%s\n' \
    "# GENERATED by home-warden scripts/setup-service -- do not edit." \
    "[Resolve]" \
    "DNS=${recursor_address}" \
    "Domains=${routing_domains# }")"
  if [[ "${generated}" == "${current}" ]]; then
    return 0
  fi
  resolved_dropin_changed=1
  if ((dry_run)); then
    echo "DRY-RUN: would write ${resolved_dropin_dest}"
    printf '%s\n' "${generated}"
    return 0
  fi
  tmp="$(mktemp)"
  printf '%s\n' "${generated}" >"${tmp}"
  run sudo install -d -m 755 "$(dirname "${resolved_dropin_dest}")"
  run sudo install -o root -g root -m 644 "${tmp}" "${resolved_dropin_dest}"
  rm -f "${tmp}"
}

# The distro pdns.service runs with ProtectHome=true, which hides /home
# entirely, so a zones.yml under the operator's home is unreadable to it.
# Bind just that directory back in, read-only (#134); pdns itself still
# needs read on the file and search on the directory.
install_pdns_sandbox_dropin() {
  local current
  local generated
  local tmp
  local zones_dir

  zones_dir="$(dirname "${pdns_zones_yaml}")"
  if [[ "$(systemctl show --property=LoadState --value pdns.service 2>/dev/null)" != "loaded" ]]; then
    echo "pdns.service not installed — skipping its sandbox drop-in"
    return 0
  fi
  current="$(cat "${pdns_dropin_dest}" 2>/dev/null || true)"
  if [[ "${zones_dir}" != /home/* ]]; then
    if [[ "${current}" == "# GENERATED by home-warden"* ]]; then
      pdns_dropin_changed=1
      run sudo rm -f "${pdns_dropin_dest}"
    fi
    return 0
  fi
  # pdns resolves a symlink inside its sandbox, where only the bound
  # directory is visible, so a link target elsewhere would be unreadable.
  if [[ "$(readlink -f "${pdns_zones_yaml}")" != "${pdns_zones_yaml}" ]]; then
    echo "ERROR: ${pdns_zones_yaml} is not a canonical path (relative, '..', or a symlink) —" \
      "set PDNS_ZONES_YAML to its real absolute path" >&2
    exit 1
  fi
  if ! is_safe_sandbox_bind "${zones_dir}"; then
    echo "ERROR: refusing to bind ${zones_dir} into pdns.service" \
      "(not a specific, non-hidden path under /home/<user>/)" >&2
    exit 1
  fi
  if ! pdns_has_access "${zones_dir}" x || ! pdns_has_access "${pdns_zones_yaml}" r; then
    echo "ERROR: pdns cannot read ${pdns_zones_yaml} — needs search on ${zones_dir} and read on the" \
      "file, via world bits or a group the pdns account is in" >&2
    exit 1
  fi

  generated="$(printf '%s\n' \
    "# GENERATED by home-warden scripts/setup-service -- do not edit." \
    "[Service]" \
    "ProtectHome=tmpfs" \
    "BindReadOnlyPaths=-${zones_dir}")"
  if [[ "${generated}" == "${current}" ]]; then
    return 0
  fi
  pdns_dropin_changed=1
  if ((dry_run)); then
    echo "DRY-RUN: would write ${pdns_dropin_dest}"
    printf '%s\n' "${generated}"
    return 0
  fi
  tmp="$(mktemp)"
  printf '%s\n' "${generated}" >"${tmp}"
  run sudo install -d -m 755 "$(dirname "${pdns_dropin_dest}")"
  run sudo install -o root -g root -m 644 "${tmp}" "${pdns_dropin_dest}"
  rm -f "${tmp}"
}

install_preview_conf_path() {
  local tmp

  if ((dry_run)); then
    echo "DRY-RUN: would write ${preview_conf_path_dest} -> ${preview_conf}"
    return 0
  fi

  run sudo install -d -o root -g root -m 755 "${preview_conf_path_dir}"
  tmp="$(mktemp)"
  printf '%s\n' "${preview_conf}" >"${tmp}"
  run sudo install -o root -g root -m 644 "${tmp}" "${preview_conf_path_dest}"
  rm -f "${tmp}"
}

install_sudoers() {
  local rendered
  local tmp

  rendered="$(
    sed \
      -e "s|@@OWNER@@|${owner}|g" \
      -e "s|@@PREVIEW_HELPER@@|${preview_helper_dest}|g" \
      "${sudoers_template}"
  )"

  if ((dry_run)); then
    echo "DRY-RUN: would write ${sudoers_dest}"
    echo "-----"
    printf '%s\n' "${rendered}"
    echo "-----"
    return 0
  fi

  tmp="$(mktemp)"
  printf '%s\n' "${rendered}" >"${tmp}"
  sudo visudo -cf "${tmp}" >/dev/null
  run sudo install -o root -g root -m 440 "${tmp}" "${sudoers_dest}"
  rm -f "${tmp}"
}

run_on_deploy() {
  local -r hook="${repo_dir}/scripts/on-deploy"
  local rc=0
  if [[ ! -x "${hook}" ]]; then
    echo "WARNING: ${hook} missing or not executable — skipping on-deploy" >&2
    return 0
  fi
  echo "Running scripts/on-deploy..."
  if ((dry_run)); then
    echo "DRY-RUN: OWNER=${owner} SERVICE_GROUP=${service_group} SCRATCH_DIR=${scratch_dir}" \
      "CONF_DIR=${conf_dir} HOME_NGINX_CONF=${home_nginx_conf} ${hook}"
    return 0
  fi
  set +e
  OWNER="${owner}" SERVICE_GROUP="${service_group}" SCRATCH_DIR="${scratch_dir}" \
    CONF_DIR="${conf_dir}" HOME_NGINX_CONF="${home_nginx_conf}" "${hook}"
  rc=$?
  set -e
  case "${rc}" in
    0)
      echo "on-deploy: changed (will reload/restart when units are active)"
      return 0
      ;;
    1)
      echo "on-deploy: no change"
      return 1
      ;;
    *)
      echo "ERROR: on-deploy failed (exit ${rc})" >&2
      exit "${rc}"
      ;;
  esac
}


service_restart_count() {
  systemctl show --property=NRestarts --value home-warden.service 2>/dev/null || echo 0
}

print_status() {
  local pinned_host pinned_machine_id
  pinned_host="$(hw_first_line "${hw_pinned_host_file}")"
  pinned_machine_id="$(hw_first_line "${hw_pinned_machine_id_file}")"

  echo "home-warden setup-service status"
  echo "  repo:            ${repo_dir}"
  echo "  owner:           ${owner}"
  echo "  service user:    ${service_user}:${service_group}"
  echo "  scratch:         ${scratch_dir}"
  echo "  conf:            ${conf_dir}"
  echo "  certs:           ${conf_dir}/certs/live"
  echo "  home nginx.conf: ${home_nginx_conf:-<unset>}"
  echo "  pdns zones.yml:  ${pdns_zones_yaml:-<unset, pdns wiring skipped>}"
  if [[ -f "${resolved_dropin_dest}" ]]; then
    echo "  host resolver:   ${resolved_dropin_dest}"
  else
    echo "  host resolver:   <no drop-in, local zones not routed to the recursor>"
  fi
  echo "  services.json:   ${services_json:-<unset, catalog-heal wiring skipped>}"
  echo "  deployed commit: ${deployed_commit:-$(git -C "${repo_dir}" rev-parse --short HEAD 2>/dev/null || echo '<unset>')}"
  echo "  service log:     ${scratch_dir}/home-warden.log"
  echo "  config.toml:     ${home_warden_config_path}"
  echo "  nginx error log: ${scratch_dir}/logs/error.log"
  echo "  nginx access log:${scratch_dir}/logs/access.log"
  echo "  pinned host:     ${pinned_host:-<unset>} (${hw_pinned_host_file})"
  echo "  pinned machine-id:${pinned_machine_id:-<unset>} (${hw_pinned_machine_id_file})"
  if hw_is_pinned; then
    if hw_matches_pinned_host; then
      echo "  guard status:    this host matches the pinned host"
    else
      echo "  guard status:    MISMATCH — this host is not the pinned host"
    fi
  else
    echo "  guard status:    UNPINNED — run --confirm-host to designate this host"
  fi
  echo "  local hostname:  $(hw_current_hostname_short)"
  echo "  local machine-id:$(hw_current_machine_id)"
  if command -v systemctl >/dev/null 2>&1; then
    local label
    local unit
    local en
    local ac
    local pair
    for pair in \
      "socket:home-warden.socket" \
      "service:home-warden.service" \
      "certbot_timer:home-warden-certbot.timer" \
      "reload_path:home-warden-reload.path" \
      "pdns_reload_path:home-warden-pdns-reload.path" \
      "healthcheck_timer:home-warden-healthcheck.timer" \
      "catalog_heal_timer:home-warden-catalog-heal.timer"; do
      label="${pair%%:*}"
      unit="${pair##*:}"
      en="$(systemctl is-enabled "${unit}" 2>/dev/null || true)"
      ac="$(systemctl is-active "${unit}" 2>/dev/null || true)"
      echo "  ${label} enabled: ${en:-n/a}"
      echo "  ${label} active:  ${ac:-n/a}"
    done
    en="$(systemctl is-enabled nginx.service 2>/dev/null || true)"
    ac="$(systemctl is-active nginx.service 2>/dev/null || true)"
    echo "  distro nginx:   enabled=${en:-n/a} active=${ac:-n/a}"
  fi
}

mask_distro_nginx() {
  echo "Ensuring distro nginx.service does not own 80/443..."
  if systemctl list-unit-files nginx.service >/dev/null 2>&1; then
    run sudo systemctl disable --now nginx.service 2>/dev/null || true
    run sudo systemctl mask nginx.service 2>/dev/null || true
  fi
}

# Type=simple reports "active" the moment nginx execs, even if it exits a
# moment later and Restart= loops it — so watch past one RestartSec and fail
# on any restart or non-active state rather than trusting a single probe.
confirm_running() {
  local -r settle_seconds=10
  local i
  local initial_restarts
  local nginx_procs
  local restarts
  local state

  echo "Confirming home-warden is up (watching ${settle_seconds}s for crash/restart)..."
  initial_restarts="$(service_restart_count)"
  for ((i = 0; i < settle_seconds; i++)); do
    sleep 1
    state="$(systemctl is-active home-warden.service 2>/dev/null || true)"
    restarts="$(service_restart_count)"
    if [[ "${state}" != "active" || "${restarts}" != "${initial_restarts}" ]]; then
      systemctl --no-pager --full status home-warden.socket home-warden.service || true
      echo "ERROR: home-warden.service is not staying up" \
        "(state=${state}, restarts ${initial_restarts}->${restarts})" >&2
      echo "  last lines of ${scratch_dir}/home-warden.log:" >&2
      tail -n 5 "${scratch_dir}/home-warden.log" >&2 || true
      exit 1
    fi
  done
  systemctl --no-pager --full status home-warden.socket home-warden.service || true
  nginx_procs="$(ps -o user,pid,cmd -C nginx 2>/dev/null || true)"
  echo "${nginx_procs}"
}

main() {
  local resolved

  if ((status_only)); then
    resolved="$(resolve_home_nginx_conf || true)"
    home_nginx_conf="${resolved}"
    resolved="$(resolve_pdns_zones_yaml || true)"
    pdns_zones_yaml="${resolved}"
    resolved="$(resolve_services_json || true)"
    services_json="${resolved}"
    print_status
    exit 0
  fi

  ensure_host_config

  if ! resolved="$(resolve_home_nginx_conf)"; then
    echo "ERROR: set HOME_NGINX_CONF to thehcma/home nginx/server/nginx.conf" >&2
    exit 1
  fi
  home_nginx_conf="${resolved}"

  if resolved="$(resolve_pdns_zones_yaml)"; then
    pdns_zones_yaml="${resolved}"
    pdns_enabled=1
  else
    echo "pdns zones.yml not found — skipping local DNS reload wiring (set PDNS_ZONES_YAML to enable, see #108)"
  fi

  if resolved="$(resolve_services_json)"; then
    services_json="${resolved}"
    catalog_heal_enabled=1
  else
    echo "services.json not found — skipping catalog-heal wiring (set SERVICES_JSON_PATH to enable, see #57)"
  fi

  maybe_create_web_ui_config

  require_sudo
  check_prerequisites
  ensure_service_account
  prepare_scratch
  validate_nginx_config
  nginx_extra_read_paths="$(resolve_nginx_extra_read_paths "${nginx_dump}" | paste -sd ' ' -)"
  if [[ -n "${nginx_extra_read_paths}" ]]; then
    echo "Extra read-only paths exposed to the nginx sandbox: ${nginx_extra_read_paths}"
  fi

  local on_deploy_rc=0
  set +e
  run_on_deploy
  on_deploy_rc=$?
  set -e

  grant_service_access

  deployed_commit="$(git -C "${repo_dir}" rev-parse HEAD 2>/dev/null || true)"
  expand_unit "${unit_template_dir}/home-warden.socket" "${system_unit_dir}/home-warden.socket"
  expand_unit "${unit_template_dir}/home-warden.service" "${system_unit_dir}/home-warden.service"
  expand_unit "${unit_template_dir}/home-warden-certbot.service" "${system_unit_dir}/home-warden-certbot.service"
  expand_unit "${unit_template_dir}/home-warden-certbot.timer" "${system_unit_dir}/home-warden-certbot.timer"
  expand_unit "${unit_template_dir}/home-warden-reload.service" "${system_unit_dir}/home-warden-reload.service"
  expand_unit "${unit_template_dir}/home-warden-reload.path" "${system_unit_dir}/home-warden-reload.path"
  if ((pdns_enabled)); then
    expand_unit "${unit_template_dir}/home-warden-pdns-reload.service" "${system_unit_dir}/home-warden-pdns-reload.service"
    expand_unit "${unit_template_dir}/home-warden-pdns-reload.path" "${system_unit_dir}/home-warden-pdns-reload.path"
    install_pdns_sandbox_dropin
  fi
  install_host_resolver_dropin
  expand_unit "${unit_template_dir}/home-warden-healthcheck.service" "${system_unit_dir}/home-warden-healthcheck.service"
  expand_unit "${unit_template_dir}/home-warden-healthcheck.timer" "${system_unit_dir}/home-warden-healthcheck.timer"
  if ((catalog_heal_enabled)); then
    expand_unit "${unit_template_dir}/home-warden-catalog-heal.service" "${system_unit_dir}/home-warden-catalog-heal.service"
    expand_unit "${unit_template_dir}/home-warden-catalog-heal.timer" "${system_unit_dir}/home-warden-catalog-heal.timer"
  fi
  expand_unit "${logrotate_template}" "${logrotate_dest}"
  install_host_guard_library
  install_preview_conf_path
  install_preview_helper
  install_sudoers

  mask_distro_nginx

  run sudo systemctl daemon-reload
  # Clears a StartLimitBurst= trip (or a socket failed by it) left over from
  # a previous broken deploy, so the start below is not refused outright.
  run sudo systemctl reset-failed home-warden.service home-warden.socket 2>/dev/null || true
  run sudo systemctl enable --now home-warden.socket
  run sudo systemctl enable --now home-warden-certbot.timer
  run sudo systemctl enable --now home-warden-reload.path
  if ((pdns_enabled)); then
    run sudo systemctl enable --now home-warden-pdns-reload.path
    if ((pdns_dropin_changed)); then
      run sudo systemctl try-restart pdns.service
    fi
  fi
  if ((resolved_dropin_changed)); then
    run sudo systemctl restart systemd-resolved.service
  fi
  run sudo systemctl enable --now home-warden-healthcheck.timer
  if ((catalog_heal_enabled)); then
    run sudo systemctl enable --now home-warden-catalog-heal.timer
  fi

  if systemctl is-active --quiet home-warden.service 2>/dev/null; then
    if ((on_deploy_rc == 0)); then
      # restart (not reload): unit Environment=DEPLOYED_COMMIT=… only refreshes on a new process
      echo "Restarting home-warden.service (on-deploy changed)..."
      run sudo systemctl restart home-warden.service
    fi
  else
    echo "Starting home-warden.service..."
    run sudo systemctl start home-warden.service
  fi

  if ((dry_run == 0)); then
    confirm_running
  fi

  echo
  echo "Follow logs:"
  echo "  tail --follow=name --retry ${scratch_dir}/home-warden.log"
  echo "  tail --follow=name --retry ${scratch_dir}/logs/error.log"
  echo "  tail --follow=name --retry ${scratch_dir}/logs/access.log"
  echo "  tail --follow=name --retry ${scratch_dir}/cert-renewer.log"
  echo "  tail --follow=name --retry ${scratch_dir}/nginx-test-and-reload.log"
  echo "  tail --follow=name --retry ${scratch_dir}/healthcheck.log"
  if ((catalog_heal_enabled)); then
    echo "  tail --follow=name --retry ${scratch_dir}/catalog-heal.log"
  fi
  echo "Certbot timer:     systemctl list-timers home-warden-certbot.timer"
  echo "Manual renew:      sudo systemctl start home-warden-certbot.service"
  echo "Conf watch:        systemctl status home-warden-reload.path"
  if ((pdns_enabled)); then
    echo "Zone watch:        systemctl status home-warden-pdns-reload.path"
  fi
  echo "Healthcheck timer: systemctl list-timers home-warden-healthcheck.timer"
  echo "Healthcheck mail:  ~/.config/home-warden-healthcheck.env (see etc/home-warden-healthcheck.env.example)"
  if ((catalog_heal_enabled)); then
    echo "Catalog heal timer: systemctl list-timers home-warden-catalog-heal.timer"
    echo "Catalog heal mail:  ~/.config/home-warden-catalog-heal.env (see etc/home-warden-catalog-heal.env.example)"
  fi
  print_status
}

main "$@"
