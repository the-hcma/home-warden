#!/usr/bin/env bash
# Fail-closed: nginx -t then systemctl reload home-warden.service.
# Used by home-warden-reload.service (systemd path unit).
#
# Env:
#   HOME_NGINX_CONF  nginx -c path (required unless default resolve works)
#   SCRATCH_DIR      default: ~/scratch/home-warden
#   OWNER            operator to hand SCRATCH_DIR/logs/nginx.pid back to after
#                     nginx -t (this script runs as root, via
#                     home-warden-reload.service); default: SCRATCH_DIR's
#                     existing owner
#   SERVICE_GROUP    home-warden.service's Group=, given group write on that pid
#                     file; default: the installed unit's Group=, else OWNER
#
# Exit:
#   0 — test OK and reload/restart succeeded (or service inactive: skip reload)
#   1 — nginx -t failed, or reload+restart both failed
#   2 — usage / missing conf
#
# Logging: write to stdout/stderr only. When run from home-warden-reload.service,
# systemd appends those streams to ~/scratch/home-warden/nginx-test-and-reload.log.
#
# Refuses to run anywhere but the host pinned by
# `scripts/setup-service --confirm-host` (see scripts/lib/host-guard).

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck source=scripts/lib/host-guard
source "${script_dir}/lib/host-guard"
if ! hw_host_guard_enforce "nginx-test-and-reload"; then
  exit 1
fi
# shellcheck source=scripts/lib/nginx-pid
source "${script_dir}/lib/nginx-pid"
# shellcheck source=scripts/lib/service-group
source "${script_dir}/lib/service-group"
# shellcheck source=scripts/lib/config-fingerprint
source "${script_dir}/lib/config-fingerprint"

scratch_dir="${SCRATCH_DIR:-${HOME}/scratch/home-warden}"
home_nginx_conf="${HOME_NGINX_CONF:-}"
owner="${OWNER:-$(stat -c '%U' "${scratch_dir}" 2>/dev/null || true)}"
service_group="$(hw_service_group "${owner}")"

log() {
  local msg=$1
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "${scratch_dir}"
  printf '%s %s\n' "${ts}" "${msg}"
}

if [[ -z "${home_nginx_conf}" ]]; then
  if [[ -f "${HOME}/home/nginx/conf/nginx.conf" ]]; then
    home_nginx_conf="${HOME}/home/nginx/conf/nginx.conf"
  elif [[ -f "${HOME}/home/nginx/server/nginx.conf" ]]; then
    # former directory name in thehcma/home, still read so an unrenamed checkout keeps working
    home_nginx_conf="${HOME}/home/nginx/server/nginx.conf"
  else
    log "ERROR: set HOME_NGINX_CONF"
    exit 2
  fi
fi

if [[ ! -f "${home_nginx_conf}" ]]; then
  log "ERROR: conf not found: ${home_nginx_conf}"
  exit 2
fi

log "nginx -t -c ${home_nginx_conf} -p ${scratch_dir}/"
if ! nginx -p "${scratch_dir}/" -t -c "${home_nginx_conf}"; then
  log "FAIL: nginx -t failed — refusing reload"
  exit 1
fi
log "nginx -t OK"
if [[ -n "${owner}" ]]; then
  hw_fix_nginx_pid_ownership "${scratch_dir}" "${owner}" "${service_group}"
fi

listen_state="${scratch_dir}/nginx-listens.sha256"
# `nginx -T` prints the whole effective config, included files too. A dump without the "configuration file" header is a
# failed `nginx -T` (-t above passed, so this is unexpected): the listens are then unknown, which is neither a change nor
# something to record, instead of the hash of an empty set.
listens_known=0
listens_changed=0
listen_now=""
nginx_dump="$(nginx -p "${scratch_dir}/" -T -c "${home_nginx_conf}" 2>/dev/null || true)"
if [[ "${nginx_dump}" == *"# configuration file "* ]]; then
  listens_known=1
  listen_now="$(hw_fingerprint_listens <<<"${nginx_dump}")"
  if hw_fingerprint_changed "${listen_state}" "${listen_now}"; then
    listens_changed=1
  fi
else
  log "WARN: nginx -T printed no configuration; the listen fingerprint is neither compared nor recorded this run"
fi
# this script runs as root: keep the state file (and a scratch directory it creates) the operator's
HW_STATE_OWNER="${owner}"
export HW_STATE_OWNER

if systemctl is-active --quiet home-warden.service 2>/dev/null; then
  main_pid="$(systemctl show --property=MainPID --value home-warden.service 2>/dev/null || true)"
  running_conf="$(hw_nginx_master_conf "${main_pid}")"
  unit_conf="$(hw_unit_nginx_conf home-warden.service)"
  if ((listens_changed)); then
    # nginx gets its privileged listening sockets (80, 443) from home-warden.socket as inherited fds, so neither a
    # reload nor a restart of the service alone can add or move one (docs/architecture-socket-activation.md); that is
    # setup-service's job (the IPv6 drop-ins), and it records the new fingerprint, which clears this. Until then the
    # warning repeats, whichever of the branches below runs. Unprivileged ports nginx opens itself, so they are not here.
    log "WARN: the privileged listen directives (ports below 1024) changed; run scripts/setup-service, which manages the socket"
  fi
  if [[ -n "${unit_conf}" && "${unit_conf}" != "${home_nginx_conf}" ]]; then
    # a restart would start nginx with the unit's own -c path, so it cannot help; rewriting the unit can
    log "WARN: home-warden.service starts nginx with -c ${unit_conf} but the config is ${home_nginx_conf}; run scripts/setup-service to rewrite the unit — reloading what is running"
  elif [[ -n "${running_conf}" && "${running_conf}" != "${home_nginx_conf}" ]]; then
    log "restarting home-warden.service (nginx runs ${running_conf}, the config is now ${home_nginx_conf}; a reload cannot change that)"
    if systemctl restart home-warden.service; then
      log "restart OK"
      if ((listens_known && listens_changed == 0)); then hw_fingerprint_save "${listen_state}" "${listen_now}"; fi
      exit 0
    fi
    log "FAIL: restart failed"
    exit 1
  fi
  log "reloading home-warden.service"
  if systemctl reload home-warden.service; then
    log "reload OK"
    if ((listens_known && listens_changed == 0)); then hw_fingerprint_save "${listen_state}" "${listen_now}"; fi
  else
    log "reload failed — trying restart"
    if systemctl restart home-warden.service; then
      log "restart OK"
    else
      log "FAIL: reload and restart both failed"
      exit 1
    fi
  fi
else
  log "home-warden.service not active — skip reload"
fi

exit 0
