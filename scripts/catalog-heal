#!/usr/bin/env bash
# Detect and heal cert/external-DNS drift across the catalog; alert on
# local-DNS/upstream drift. Thin wrapper around the app.catalog_heal_cli
# console script -- see that module's docstring for env vars, flags, and
# exit codes.
# See the-hcma/home-warden#57.
#
# Usage:
#   ./scripts/catalog-heal --target 203.0.113.10
#   ./scripts/catalog-heal --target 203.0.113.10 --apply-cert
#   ./scripts/catalog-heal --target 203.0.113.10 --apply-cert --apply-dns

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_dir}"

if ! command -v uv >/dev/null 2>&1; then
  echo "catalog-heal: install uv (https://docs.astral.sh/uv/) or run 'uv sync' in ${repo_dir}" >&2
  exit 1
fi

exec uv run catalog-heal "$@"
