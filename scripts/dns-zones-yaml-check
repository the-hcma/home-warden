#!/usr/bin/env bash
# Lightweight, offline syntax/shape check of a PowerDNS GeoIP-backend
# zones.yml file. Thin wrapper around the app.dns_zones_yaml_check_cli
# console script -- see that module's docstring for usage/exit codes.
# See the-hcma/home-warden#108.
#
# Usage:
#   ./scripts/dns-zones-yaml-check path/to/zones.yml

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_dir}"

if ! command -v uv >/dev/null 2>&1; then
  echo "dns-zones-yaml-check: install uv (https://docs.astral.sh/uv/) or run 'uv sync' in ${repo_dir}" >&2
  exit 1
fi

exec uv run dns-zones-yaml-check "$@"
