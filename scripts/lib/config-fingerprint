#!/usr/bin/env bash
# Fingerprints of the config that a reload cannot apply, so the reload scripts know when a restart is needed.
#
# nginx: a reload (HUP) re-reads the file nginx was started with, but it cannot change the listening sockets or the -c
# path of the running master. The recursor: `rec_control reload-zones` applies forward zones only, not the rest of
# recursor.yml (access list, listen addresses, ...).
#
# State lives in a file per fingerprint. No state file means "first run": record, do not restart.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=nginx-conf-statements
source "$(dirname "${BASH_SOURCE[0]}")/nginx-conf-statements"

# hw_fingerprint_listen_specs -- reads `nginx -T` output (the whole effective config, included files too) on stdin and prints
# the PRIVILEGED listen addresses in it (port below 1024, no unix sockets), one per line, sorted and unique, as `address:port`
# (a bare `listen 443` stays `443`; an address with no port, as in `listen [::];`, is port 80 as nginx reads it). The
# config is split into statements the way nginx's lexer does (lib/nginx-conf-statements), so `server { listen [::]:443
# ssl; }` on one line, or a directive spread over several lines, counts. Only privileged ports matter here: nginx runs
# unprivileged and gets ports 80 and 443 as inherited fds from home-warden.socket, which only setup-service can change,
# while any other port nginx opens itself on a reload. It is a set: every vhost repeats its own `listen 443 ssl;`, and
# flags such as ssl or default_server are not part of the address. Quotes around a token are removed first, as nginx
# does, and a datagram listener (`udp`, `quic`) is a different address than the TCP one on the same port: it carries a
# `/udp` suffix, which also makes it unsupported by the sockets.
hw_fingerprint_listen_specs() {
  local dump

  dump="$(cat)"
  nginx_conf_statements "${dump}" |
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^".*"$/ || $i ~ /^'"'"'.*'"'"'$/) $i = substr($i, 2, length($i) - 2) }
    $1 == "listen" && NF >= 2 {
      spec = $2
      transport = ""
      for (i = 3; i <= NF; i++) if ($i == "udp" || $i == "quic") transport = "/udp"
      if (spec ~ /^unix:/) next
      if (spec ~ /^[0-9]+$/) { port = spec }
      else if (spec ~ /^\[.*\]:[0-9]+$/) { port = spec; sub(/^.*\]:/, "", port) }
      else if (spec ~ /^\[.*\]$/) { port = 80; spec = spec ":80" }
      else if (spec ~ /:[0-9]+$/) { port = spec; sub(/^.*:/, "", port) }
      else { port = 80; spec = spec ":80" }
      if (port + 0 < 1024) print spec transport
    }' |
    sort -u
}

# hw_fingerprint_listens -- sha256 of the set printed by hw_fingerprint_listen_specs (stdin: `nginx -T` output). A config
# without any such listen is valid and hashes the empty set.
hw_fingerprint_listens() {
  hw_fingerprint_listen_specs | sha256sum | cut -d' ' -f1
}

# hw_listen_specs_unsupported -- reads the specs on stdin and prints those home-warden.socket cannot supply: it binds
# 0.0.0.0:80 and 0.0.0.0:443, and setup-service adds [::]:80 and [::]:443 for matching listens, so any other privileged
# address (127.0.0.1:443, a second port, ...) would be bound by nginx itself, which the unprivileged account cannot.
hw_listen_specs_unsupported() {
  { grep -Evx '80|443|\*:80|\*:443|0\.0\.0\.0:80|0\.0\.0\.0:443|\[::\]:80|\[::\]:443' || true; }
}

# hw_fingerprint_files <file>... -- sha256 over a manifest of every given file that exists (symlinks followed): one
# `<sha256 of the contents>  <name>` record each
hw_fingerprint_files() {
  local f
  local digest
  # one record per file: the digest of its contents, then its name. Hashing the content first keeps the record
  # boundaries unambiguous (a file whose content looks like another file's record cannot mimic it).
  for f in "$@"; do
    if [[ -f "${f}" ]]; then
      digest="$(sha256sum <"${f}" | cut -d' ' -f1)"
      printf '%s  %s\n' "${digest}" "${f##*/}"
    fi
  done | sha256sum | cut -d' ' -f1
}

# hw_fingerprint_changed <state-file> <fingerprint> -- 0 when a saved fingerprint exists and differs
hw_fingerprint_changed() {
  local -r state="$1"
  local -r now="$2"
  local saved

  [[ -f "${state}" ]] || return 1
  saved="$(<"${state}")"
  [[ "${saved}" != "${now}" ]]
}

# hw_fingerprint_save <state-file> <fingerprint>
hw_fingerprint_save() {
  local dir
  local created=0

  dir="$(dirname "$1")"
  if [[ ! -d "${dir}" ]]; then
    mkdir -p "${dir}" || return 1
    created=1
  fi
  # explicit: inside a caller's `||` list errexit is off, and a failed write must not look like success
  printf '%s\n' "$2" >"$1" || return 1
  # a root-run reload script must not leave a root-owned file, or a root-owned scratch directory it just created,
  # where the operator's own tools (setup-service) have to write
  if [[ "${EUID}" -eq 0 && -n "${HW_STATE_OWNER:-}" ]]; then
    chown "${HW_STATE_OWNER}" "$1" 2>/dev/null || true
    if ((created)); then chown "${HW_STATE_OWNER}" "${dir}" 2>/dev/null || true; fi
  fi
}

# hw_nginx_record_listens <scratch-dir> -- reads `nginx -T` output on stdin (the caller runs it with whatever privilege the
# served config needs, e.g. `sudo nginx -T`) and records its listen fingerprint as applied. setup-service calls this after
# it restarted the socket and the service, which is what clears the reload script's listen warning. A dump without a
# "configuration file" header is a failed `nginx -T` (an unreadable cert, no sudo, ...): nothing is recorded, because
# the hash of an empty listen set would make the warning repeat forever. Returns 1 then. A privileged listen the sockets
# cannot supply (hw_listen_specs_unsupported) is not recorded either, so the saved fingerprint stays and the warning
# keeps naming the problem; that returns 2.
hw_nginx_record_listens() {
  local dump unsupported

  dump="$(cat)"
  if [[ "${dump}" != *"# configuration file "* ]]; then
    return 1
  fi
  unsupported="$(hw_fingerprint_listen_specs <<<"${dump}" | hw_listen_specs_unsupported)"
  if [[ -n "${unsupported}" ]]; then
    echo "ERROR: home-warden.socket cannot supply these privileged listen addresses (it binds 80 and 443 on IPv4, and [::]:80, [::]:443 for matching listens): ${unsupported//$'\n'/ }" >&2
    return 2
  fi
  hw_fingerprint_save "$1/nginx-listens.sha256" "$(hw_fingerprint_listens <<<"${dump}")"
}

# hw_nginx_master_conf <main-pid> -- the -c path the running nginx master was started with (empty when unknown)
hw_nginx_master_conf() {
  local -r pid="$1"

  [[ -n "${pid}" && "${pid}" != 0 ]] || return 0
  ps -ww -o args= -p "${pid}" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "-c") { print $(i + 1); exit } }' || true
}

# hw_unit_nginx_conf <unit> -- the -c path in the unit's ExecStart (what `systemctl restart` would start nginx with)
hw_unit_nginx_conf() {
  # `|| true`: callers run under `set -euo pipefail`, and a failing `systemctl show` must not abort a reload nginx -t passed
  systemctl show --property=ExecStart --value "$1" 2>/dev/null | sed -nE 's/.* -c ([^ ;]+).*/\1/p' | head -n1 || true
}

# hw_recursor_restart_if_changed <recursor.yml> <state-file> <unit> -- restart the recursor when its config changed.
# Needs the caller's `log`. Returns 0 (nothing to do, first run recorded, or restarted) or 1 (invalid config, or the
# restart failed; nothing is restarted into an invalid file and the saved fingerprint stays, so the next run retries).
hw_recursor_restart_if_changed() {
  local -r yaml="$1"
  local -r state="$2"
  local -r unit="$3"
  local conf_dir fp

  [[ -e "${yaml}" ]] || return 0
  conf_dir="$(dirname "${yaml}")"
  fp="$(hw_fingerprint_files "$(readlink -f "${yaml}")" "${conf_dir}"/recursor.d/*.yml)"
  if hw_fingerprint_changed "${state}" "${fp}"; then
    log "recursor config changed — validating before a restart (a reload cannot apply it)"
    if ! pdns_recursor --config=check --config-dir="${conf_dir}" >/dev/null 2>&1; then
      log "FAIL: pdns_recursor --config=check rejected ${yaml} — recursor not restarted"
      return 1
    fi
    log "restarting ${unit}"
    if ! systemctl restart "${unit}"; then
      log "FAIL: restart of ${unit} failed"
      return 1
    fi
    # the control socket appears a moment after the restart; reload-zones needs it. Saved only once it answers: a
    # restart that never comes up must be retried on the next run, not recorded as applied
    for _ in $(seq 1 30); do
      if rec_control ping >/dev/null 2>&1; then
        if ! hw_fingerprint_save "${state}" "${fp}"; then
          log "FAIL: ${unit} restarted, but the config fingerprint could not be saved to ${state}; the next run will restart it again"
          return 1
        fi
        log "recursor restart OK"
        return 0
      fi
      sleep "${HW_RECURSOR_PING_WAIT:-0.5}"
    done
    log "FAIL: ${unit} was restarted but did not answer its control socket"
    return 1
  elif [[ ! -f "${state}" ]]; then
    if ! hw_fingerprint_save "${state}" "${fp}"; then
      log "FAIL: could not record the recursor config fingerprint in ${state}; config changes would never trigger a restart"
      return 1
    fi
    log "recorded the recursor config fingerprint (first run, no restart)"
  fi
  return 0
}
