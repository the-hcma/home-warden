#!/usr/bin/env bash
# scripts/lib/nginx-socket-listens — which IPv6 sockets home-warden.socket must
# add for the served nginx conf, and the systemd drop-ins that add them (#156).
#
# nginx takes over an inherited socket only when a `listen` names its exact
# address. A listen on 80/443 with no matching socket makes nginx bind it
# itself, which the unprivileged home-warden-nginx account can't, so startup
# fails. A socket with no matching listen is closed by nginx while systemd
# keeps its copy open, so connections to it queue and are never answered.
# home-warden.socket always binds 0.0.0.0:80 and 0.0.0.0:443 (fds 3 and 4);
# each `listen [::]:80` / `listen [::]:443` in the conf adds the matching
# IPv6-only socket, so the sockets follow the conf instead of the two having
# to change in lockstep.

readonly nginx_socket_dropin_header="# GENERATED by home-warden scripts/setup-service -- do not edit."

# render_ipv6_service_dropin <port>...: home-warden.service drop-in listing
# every inherited fd in NGINX=, the two IPv4 sockets plus one per IPv6 port.
render_ipv6_service_dropin() {
  local fds="3:4"
  local fd=5
  local port

  for port in "$@"; do
    fds+=":${fd}"
    fd=$((fd + 1))
  done
  printf '%s\n' \
    "${nginx_socket_dropin_header}" \
    "[Service]" \
    "Environment=NGINX=${fds};"
}

# render_ipv6_socket_dropin <port>...: home-warden.socket drop-in adding an
# IPv6-only listener per port. ipv6-only keeps IPv4 clients on the 0.0.0.0
# sockets, so they log as a.b.c.d rather than ::ffff:a.b.c.d.
render_ipv6_socket_dropin() {
  local port
  local -a lines=()

  for port in "$@"; do
    lines+=("ListenStream=[::]:${port}")
  done
  printf '%s\n' \
    "${nginx_socket_dropin_header}" \
    "[Socket]" \
    "BindIPv6Only=ipv6-only" \
    "${lines[@]}"
}

# resolve_nginx_ipv6_listen_ports <nginx -T dump>
# Prints, one per line in ascending order, each of 80 / 443 that a
# `listen [::]:<port>` (or a bare `listen [::]`, which is port 80) names.
# Fails when such a listen sets ipv6only=off: that dual-stack socket would
# collide with the IPv4 socket home-warden.socket already binds.
resolve_nginx_ipv6_listen_ports() {
  local -r dump="$1"
  local found=""
  local params
  local port
  local status=0

  # `[::]` prefixes the port field so a bare `listen [::] ssl;` can't shift
  # `ssl` into it.
  while read -r port params; do
    port="${port#\[::\]}"
    port="${port#:}"
    port="${port:-80}"
    if [[ "${port}" != 80 && "${port}" != 443 ]]; then
      continue
    fi
    if [[ " ${params} " == *" ipv6only=off "* ]]; then
      echo "ERROR: listen [::]:${port} sets ipv6only=off; home-warden.socket already binds" \
        "0.0.0.0:${port}, so use a separate \`listen ${port}\` and \`listen [::]:${port}\`" >&2
      status=1
      continue
    fi
    found+="${port}"$'\n'
  done < <(
    sed -nE 's/^[[:space:]]*listen[[:space:]]+(\[::\](:[0-9]+)?)([[:space:]][^;]*)?;.*$/\1 \3/p' <<<"${dump}"
  )
  if [[ -n "${found}" ]]; then
    printf '%s' "${found}" | sort -n -u
  fi
  return "${status}"
}
