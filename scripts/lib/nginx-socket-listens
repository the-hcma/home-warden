#!/usr/bin/env bash
# scripts/lib/nginx-socket-listens — which IPv6 sockets home-warden.socket must
# add for the served nginx conf, and the systemd drop-ins that add them (#156).
#
# nginx takes over an inherited socket only when a `listen` names its exact
# address. A listen on 80/443 with no matching socket makes nginx bind it
# itself, which the unprivileged home-warden-nginx account can't, so startup
# fails. A socket with no matching listen is closed by nginx while systemd
# keeps its copy open, so connections to it queue and are never answered.
# home-warden.socket always binds 0.0.0.0:80 and 0.0.0.0:443 (fds 3 and 4);
# each `listen [::]:80` / `listen [::]:443` in the conf adds the matching
# IPv6-only socket, so the sockets follow the conf instead of the two having
# to change in lockstep.

readonly nginx_socket_dropin_header="# GENERATED by home-warden scripts/setup-service -- do not edit."

# render_ipv6_service_dropin <port>...: home-warden.service drop-in listing
# every inherited fd in NGINX=, the two IPv4 sockets plus one per IPv6 port.
render_ipv6_service_dropin() {
  local fds="3:4"
  local fd=5
  local port

  for port in "$@"; do
    fds+=":${fd}"
    fd=$((fd + 1))
  done
  printf '%s\n' \
    "${nginx_socket_dropin_header}" \
    "[Service]" \
    "Environment=NGINX=${fds};"
}

# render_ipv6_socket_dropin <port>...: home-warden.socket drop-in adding an
# IPv6-only listener per port. ipv6-only keeps IPv4 clients on the 0.0.0.0
# sockets, so they log as a.b.c.d rather than ::ffff:a.b.c.d.
render_ipv6_socket_dropin() {
  local port
  local -a lines=()

  for port in "$@"; do
    lines+=("ListenStream=[::]:${port}")
  done
  printf '%s\n' \
    "${nginx_socket_dropin_header}" \
    "[Socket]" \
    "BindIPv6Only=ipv6-only" \
    "${lines[@]}"
}

# resolve_nginx_ipv6_listen_ports <nginx -T dump>
# Prints, one per line in ascending order, each of 80 / 443 that a
# `listen [::]:<port>` (or a bare `listen [::]`, which is port 80) names.
# Fails when such a listen sets ipv6only=off: that dual-stack socket would
# collide with the IPv4 socket home-warden.socket already binds.
resolve_nginx_ipv6_listen_ports() {
  local -r dump="$1"
  local found=""
  local params
  local port
  local status=0

  # nginx treats newlines as whitespace, so the dump (comments stripped) is
  # split into statements at `;`, `{` and `}`, not lines: a listen spread over
  # lines or following `server {` still counts. `[::]` prefixes the port field
  # so a bare `listen [::] ssl;` can't shift `ssl` into it.
  while read -r port params; do
    port="${port#\[::\]}"
    port="${port#:}"
    port="${port:-80}"
    if [[ "${port}" != 80 && "${port}" != 443 ]]; then
      continue
    fi
    if [[ " ${params} " == *" ipv6only=off "* ]]; then
      echo "ERROR: listen [::]:${port} sets ipv6only=off; home-warden.socket already binds" \
        "0.0.0.0:${port}, so use a separate \`listen ${port}\` and \`listen [::]:${port}\`" >&2
      status=1
      continue
    fi
    found+="${port}"$'\n'
  done < <(
    sed -E 's/#.*$//' <<<"${dump}" |
      tr '\n' ' ' |
      sed -E 's/[{};]/\n/g' |
      sed -nE 's/^[[:space:]]*listen[[:space:]]+(\[::\](:[0-9]+)?)([[:space:]].*)?$/\1 \3/p'
  )
  if [[ -n "${found}" ]]; then
    printf '%s' "${found}" | sort -n -u
  fi
  return "${status}"
}

# sync_ipv6_socket_dropins <nginx -T dump> <service drop-in> <socket drop-in>
# Brings both drop-ins in line with the conf's IPv6 listens: writes them when
# their content differs, and removes them (only if generated, never a
# hand-written file) when the conf has none. The caller supplies the file
# operations as install_generated_dropin <content> <dest> and
# remove_generated_dropin <dest>. Prints "changed" when it wrote or removed
# anything; fails, touching nothing, when a listen is refused.
sync_ipv6_socket_dropins() {
  local -r dump="$1"
  local -r service_dest="$2"
  local -r socket_dest="$3"
  local changed=0
  local current
  local dest
  local generated
  local i
  local ports
  local -a dests=("${service_dest}" "${socket_dest}")
  local -a generated_dropins=()
  local -a port_list=()

  if ! ports="$(resolve_nginx_ipv6_listen_ports "${dump}")"; then
    return 1
  fi
  if [[ -z "${ports}" ]]; then
    for dest in "${dests[@]}"; do
      current="$(cat "${dest}" 2>/dev/null || true)"
      if [[ "${current}" == "${nginx_socket_dropin_header}"* ]]; then
        remove_generated_dropin "${dest}"
        changed=1
      fi
    done
  else
    mapfile -t port_list <<<"${ports}"
    echo "IPv6 sockets for home-warden.socket (from listen [::]:… in the conf): ${port_list[*]}" >&2
    generated_dropins=(
      "$(render_ipv6_service_dropin "${port_list[@]}")"
      "$(render_ipv6_socket_dropin "${port_list[@]}")"
    )
    for i in "${!dests[@]}"; do
      dest="${dests[i]}"
      generated="${generated_dropins[i]}"
      current="$(cat "${dest}" 2>/dev/null || true)"
      if [[ "${generated}" != "${current}" ]]; then
        install_generated_dropin "${generated}" "${dest}"
        changed=1
      fi
    done
  fi
  if ((changed)); then
    echo changed
  fi
}
