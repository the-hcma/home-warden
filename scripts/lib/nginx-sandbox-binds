#!/usr/bin/env bash
# scripts/lib/nginx-sandbox-binds — which paths from the served nginx conf
# home-warden.service's sandbox must bind back in, and which it refuses; plus
# which directories home-warden-reload.path must watch beyond the conf's own.
#
# home-warden.service runs with ProtectHome=tmpfs, so any file the served conf
# references under /home or /root is invisible unless bind-mounted back in
# (BindReadOnlyPaths=, rendered by scripts/setup-service).
#
# A bind mount of a single file pins that file's inode: when its owner
# replaces it by writing a temp file and renaming it over the original (how a
# CRL is republished), the sandbox keeps seeing the old file, and an nginx
# reload rereads the same stale copy. Directives whose file is expected to be
# republished that way therefore bind the containing directory, which follows
# renames within it (#148):
#   ssl_crl, ssl_client_certificate, ssl_trusted_certificate
# Other file directives still bind just the file, so a key's directory is not
# exposed for the sake of its certificate. A republished file whose directory
# holds a private key (e.g. a CA store keeping crl.pem beside ca.key) also
# falls back to a single-file bind: stale-until-restart, but the key stays
# outside the sandbox.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=nginx-conf-statements
source "$(dirname "${BASH_SOURCE[0]}")/nginx-conf-statements"

# dir_holds_private_key <dir>: true when <dir> (recursively, as a bind would
# expose it) contains a PEM private key or a file named like a key/keystore.
# A missing or unreadable dir counts as holding none.
dir_holds_private_key() {
  local -r dir="$1"
  local found
  found="$(
    find "${dir}" -type f \( -name '*.key' -o -name '*.p12' -o -name '*.pfx' \) -print -quit 2>/dev/null
  )" || true
  if [[ -n "${found}" ]]; then
    return 0
  fi
  grep --recursive --quiet --no-messages --extended-regexp \
    -- '-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----' "${dir}"
}

# Accepts only /home/<user>/<segment>[/<segment>...] (target already
# normalized) where every segment is plain [A-Za-z0-9._@+-] not starting with
# a dot. That refuses /root, /home, a bare home dir, hidden paths (~/.ssh,
# ~/.config, `..`), and any character (backslash, `&`, `|`, whitespace) that
# could escape the sed substitution expand_unit renders these into.
is_safe_sandbox_bind() {
  local -r target="$1"
  local -r segment='[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*'
  [[ "${target}" =~ ^/home/${segment}(/${segment})+$ ]]
}

# nginx directives whose argument is a filesystem path the sandbox may need.
nginx_path_directives=(
  alias
  auth_basic_user_file
  include
  root
  ssl_certificate
  ssl_certificate_key
  ssl_client_certificate
  ssl_crl
  ssl_dhparam
  ssl_password_file
  ssl_trusted_certificate
)
readonly -a nginx_path_directives

# resolve_nginx_reload_watch_dirs <nginx -T dump> [<watched dir>...]
# Prints, one per line, the directory of every ssl_crl / ssl_client_certificate
# path the conf references, minus the dirs already watched. nginx rereads
# those files only on reload, so home-warden-reload.path watches their
# directories: a directory watch catches an atomic-rename republish, which a
# watch on the file itself would lose track of (#151). A PathModified= watch
# is not recursive, so only an exact match counts as already watched. Paths
# systemd would misparse (whitespace, quotes, a `$` variable) are warned
# about and skipped.
resolve_nginx_reload_watch_dirs() {
  local -r dump="$1"
  shift
  local -a watched_dirs=("$@")
  local directive
  local dir
  local path
  local skip
  local watched

  while read -r directive path; do
    path="${path//\"/}"
    path="${path//\'/}"
    if [[ ! "${path}" =~ ^/[A-Za-z0-9._@+/-]+$ ]]; then
      echo "WARNING: not watching ${path} (from ${directive}) for reloads:" \
        "only plain absolute paths are supported" >&2
      continue
    fi
    dir="$(dirname "${path}")"
    while [[ "${dir}" == *//* ]]; do
      dir="${dir//\/\//\/}"
    done
    skip=0
    for watched in "${watched_dirs[@]}"; do
      if [[ "${dir}" == "${watched%/}" ]]; then
        skip=1
      fi
    done
    if ((skip == 0)); then
      printf '%s\n' "${dir}"
    fi
  done < <(
    nginx_conf_statements "${dump}" |
      sed -nE 's/^[[:space:]]*(ssl_client_certificate|ssl_crl)[[:space:]]+(.*[^[:space:]])[[:space:]]*$/\1 \2/p'
  ) | sort -u
}

# resolve_nginx_extra_read_paths <nginx -T dump> [<covered dir>...]
# Prints one `-<path>` per line (the `-` makes systemd skip a path that has
# since disappeared instead of refusing to start) for every location under
# /home or /root the conf references that no covered dir already contains.
# root/alias, glob includes, and republished files (see the header) bind a
# directory; other file directives bind just the file. The whole argument (the rest
# of the statement) is captured so a path the allowlist can't take (e.g. a quoted one
# with a space) is warned about, never silently dropped. The conf is not
# trusted to widen the sandbox arbitrarily: see is_safe_sandbox_bind for what
# is refused — including a republished file sitting directly in a home
# directory, whose directory would be the whole home.
resolve_nginx_extra_read_paths() {
  local -r dump="$1"
  shift
  local -a covered_dirs=("$@")
  local covered
  local directive
  local directive_re
  local path
  local skip
  local target

  directive_re="$(
    IFS='|'
    printf '%s' "${nginx_path_directives[*]}"
  )"
  while read -r directive path; do
    path="${path//\"/}"
    path="${path//\'/}"
    if [[ "${path}" != /home/* && "${path}" != /root/* ]] || [[ "${path}" == *'$'* ]]; then
      continue
    fi
    case "${directive}" in
      alias | root) target="${path%/}" ;;
      include)
        if [[ "${path}" == *[*?[]* ]]; then
          target="$(dirname "${path}")"
        else
          target="${path}"
        fi
        ;;
      ssl_client_certificate | ssl_crl | ssl_trusted_certificate)
        target="$(dirname "${path}")"
        if dir_holds_private_key "${target}"; then
          echo "WARNING: binding ${path} (from ${directive}) as a single file: ${target} holds a" \
            "private key, so a renamed replacement stays stale until home-warden.service" \
            "restarts — publish it from a key-free dir" >&2
          target="${path}"
        fi
        ;;
      *) target="${path}" ;;
    esac
    while [[ "${target}" == *//* ]]; do
      target="${target//\/\//\/}"
    done
    if [[ "${target}" != / ]]; then
      target="${target%/}"
    fi
    skip=0
    for covered in "${covered_dirs[@]}"; do
      if [[ "${target}" == "${covered}" || "${target}" == "${covered}"/* ]]; then
        skip=1
      fi
    done
    if ((skip)); then
      continue
    fi
    if ! is_safe_sandbox_bind "${target}"; then
      echo "WARNING: not exposing ${target} (from ${directive}) to the nginx sandbox:" \
        "only plain paths below /home/<user>/ are allowed — move it under a dedicated dir" >&2
      continue
    fi
    printf -- '-%s\n' "${target}"
  done < <(
    nginx_conf_statements "${dump}" |
      sed -nE "s/^[[:space:]]*(${directive_re})[[:space:]]+(.*[^[:space:]])[[:space:]]*\$/\1 \2/p"
  ) | sort -u
}
