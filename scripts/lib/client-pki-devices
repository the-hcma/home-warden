#!/usr/bin/env bash
# scripts/lib/client-pki-devices — the operator's device workflow on top of
# the tiny-pki CLI: enroll a device and rotate its certificate without cutting
# it off. A device gets either a PKCS#12 bundle the CA builds (--password-file)
# or a certificate for a key it generated itself (--csr), which never leaves
# the device. Sourced by scripts/client-pki, which defines client_pki_tiny_pki
# (tiny-pki pinned to the store). See docs/client-pki.md and
# the-hcma/home-warden#159.
#
# tiny-pki's plain `create client <cn>` and `sign client <cn>` revoke the CN's
# current certificate at once, so enroll refuses a CN that already has one and
# rotate always passes --keep-previous. Both run under client_pki_locked, so a
# concurrent enroll can't slip in between the check and the issue; a hand-run
# `client-pki create client` doesn't take that lock.

# Print the serials of <cn>'s active client certificates, one per line.
client_pki_active_serials() {
  local -r cn="$1"
  client_pki_tiny_pki list clients --json | python3 -c '
import json, sys
cn = sys.argv[1]
entries = json.load(sys.stdin)
for entry in entries if isinstance(entries, list) else [entries]:
    if entry.get("cn") == cn and entry.get("status") == "active":
        print(entry["serial"])
' "${cn}"
}

# Fail before anything is issued when <out> can't be written. tiny-pki records
# the certificate in the store before it writes --out, so discovering a bad path
# afterwards leaves a certificate the operator has to go and recover.
client_pki_check_out_writable() {
  local -r out="$1"
  local dir

  dir="$(dirname -- "${out}")"
  if [[ -d "${out}" ]]; then
    echo "client-pki: --out ${out} is a directory; nothing issued" >&2
    return 1
  fi
  if [[ ! -d "${dir}" || ! -w "${dir}" ]]; then
    echo "client-pki: cannot write ${out}: ${dir} is not a writable directory; nothing issued" >&2
    return 1
  fi
  if [[ -e "${out}" && ! -w "${out}" ]]; then
    echo "client-pki: cannot write ${out}: the file is not writable; nothing issued" >&2
    return 1
  fi
}

# After a failed CSR signing: if the store nonetheless gained a certificate for
# <cn> (it was recorded, then writing --out failed), say how to get it back.
client_pki_note_issued_but_unwritten() {
  local -r cn="$1"
  local -r previous_count="$2"
  local current count

  current="$(client_pki_active_serials "${cn}")" || return 0
  count="$(printf '%s\n' "${current}" | grep --count .)" || count=0
  if ((count > previous_count)); then
    echo "client-pki: the certificate for ${cn} was recorded in the store but could not be written;" \
      "recover it with ./scripts/client-pki export pem ${cn} --out PATH" >&2
  fi
}

# enroll <cn> (--password-file PATH [--legacy] | --csr PATH [--fingerprint HEX]
# [--out PATH]): issue a device's first certificate.
client_pki_enroll() {
  local cn previous rc=0
  client_pki_parse_device_args "enroll" "$@" || return
  cn="${client_pki_device_cn}"

  if ! previous="$(client_pki_active_serials "${cn}")"; then
    echo "client-pki: could not list ${cn}'s certificates; nothing issued" >&2
    return 1
  fi
  if [[ -n "${previous}" ]]; then
    echo "client-pki: ${cn} already has an active certificate; use 'client-pki rotate ${cn}' to replace it" >&2
    return 1
  fi
  if [[ -n "${client_pki_device_csr}" ]]; then
    client_pki_sign_csr "${cn}" || rc=$?
    if ((rc != 0)); then
      client_pki_note_issued_but_unwritten "${cn}" 0
    fi
    return "${rc}"
  fi
  client_pki_tiny_pki create client "${cn}" || return
  client_pki_export_bundle "${cn}"
}

client_pki_export_bundle() {
  local -r cn="$1"
  local -a extra=()

  if ((client_pki_device_legacy)); then
    extra=(--legacy)
  fi
  client_pki_tiny_pki export p12 "${cn}" --password-file "${client_pki_device_password_file}" "${extra[@]}" || return
  echo "client-pki: send the .p12 and its password to the device separately; delete the .p12 once it's installed"
}

# Print the SHA-256 public-key fingerprint of <csr> with the colons removed,
# after showing the operator tiny-pki's summary of it on stderr. Fails when
# tiny-pki would refuse to sign it.
client_pki_csr_fingerprint() {
  local -r csr="$1"
  local summary fingerprint

  if ! summary="$(client_pki_tiny_pki inspect "${csr}")"; then
    echo "client-pki: could not read the CSR ${csr}; nothing issued" >&2
    return 1
  fi
  printf '%s\n' "${summary}" >&2
  if [[ "${summary}" == *"status    refused"* ]]; then
    echo "client-pki: tiny-pki refuses this CSR (see above); have the device generate a new one" >&2
    return 1
  fi
  fingerprint="$(awk '/^public key sha256 / { print $4 }' <<<"${summary}")"
  if [[ -z "${fingerprint}" ]]; then
    echo "client-pki: tiny-pki printed no public-key fingerprint for ${csr}; nothing issued" >&2
    return 1
  fi
  printf '%s\n' "${fingerprint//:/}"
}

# Have the operator vouch for <fingerprint> (colon-free, upper case): it must
# match --fingerprint, or be confirmed at a terminal prompt.
client_pki_confirm_fingerprint() {
  local -r fingerprint="$1"
  local expected answer

  if [[ -n "${client_pki_device_fingerprint}" ]]; then
    expected="${client_pki_device_fingerprint//[: ]/}"
    if [[ "${expected^^}" != "${fingerprint}" ]]; then
      echo "client-pki: the CSR's public key does not match --fingerprint; nothing issued" >&2
      return 1
    fi
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "client-pki: confirm the CSR's public key with --fingerprint HEX when not running at a terminal" >&2
    return 1
  fi
  read -r -p "Has the device's owner confirmed this public key sha256? [y/N] " answer || answer=""
  if [[ "${answer,,}" != y && "${answer,,}" != yes ]]; then
    echo "client-pki: fingerprint not confirmed; nothing issued" >&2
    return 1
  fi
}

# Sign the device's CSR as <cn> once its fingerprint is confirmed, keeping the
# previous certificate when rotating. Inspection and signing both read a
# private snapshot of the CSR, so a file swapped while the operator checks the
# fingerprint can't get the swapped-in key signed.
client_pki_sign_csr() {
  local -r cn="$1"
  shift
  local fingerprint out snapshot_dir snapshot rc=0
  local -a extra=("$@")

  snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/client-pki-csr.XXXXXX")" || return
  # The script ends after this verb, so an EXIT trap also covers Ctrl-C.
  # shellcheck disable=SC2064 # expand the directory now, not when the trap fires
  trap "rm -rf -- $(printf '%q' "${snapshot_dir}")" EXIT
  trap 'exit 130' HUP INT TERM
  snapshot="${snapshot_dir}/request.csr"
  if ! cp -- "${client_pki_device_csr}" "${snapshot}"; then
    echo "client-pki: could not copy the CSR ${client_pki_device_csr}; nothing issued" >&2
    rm -rf -- "${snapshot_dir}"
    return 1
  fi

  out="${client_pki_device_out:-${cn}.crt}"
  if fingerprint="$(client_pki_csr_fingerprint "${snapshot}")" && client_pki_confirm_fingerprint "${fingerprint}"; then
    client_pki_tiny_pki sign client "${cn}" --csr "${snapshot}" --out "${out}" "${extra[@]}" || rc=$?
  else
    rc=1
  fi
  rm -rf -- "${snapshot_dir}"
  if ((rc != 0)); then
    return "${rc}"
  fi
  echo "client-pki: copy ${out} and the store's public/ca.crt to the device and install them next to its key;" \
    "both are public, so any channel works"
}

# Run <command...> holding an exclusive flock on <dir> (the store's ca/). Not
# ca/.lock: tiny-pki takes that one per invocation and would deadlock.
client_pki_locked() {
  local -r lock_dir="$1"
  shift
  local fd rc=0

  if ! exec {fd}<"${lock_dir}"; then
    echo "client-pki: no CA in ${lock_dir%/ca}; run 'client-pki init' first" >&2
    return 1
  fi
  if ! flock --exclusive --timeout "${CLIENT_PKI_LOCK_TIMEOUT_SEC:-30}" "${fd}"; then
    exec {fd}<&-
    echo "client-pki: another enroll or rotate is running on ${lock_dir%/ca}; try again" >&2
    return 1
  fi
  "$@" || rc=$?
  exec {fd}<&-
  return "${rc}"
}

client_pki_device_usage() {
  local -r device_verb="$1"
  echo "usage: client-pki ${device_verb} <cn> --password-file PATH [--legacy]" >&2
  echo "       client-pki ${device_verb} <cn> --csr PATH [--fingerprint HEX] [--out PATH]" >&2
}

# Parse `<cn>` plus either `--password-file PATH [--legacy]` or `--csr PATH
# [--fingerprint HEX] [--out PATH]` into client_pki_device_*.
client_pki_parse_device_args() {
  local -r device_verb="$1"
  shift
  client_pki_device_cn=""
  client_pki_device_csr=""
  client_pki_device_fingerprint=""
  client_pki_device_legacy=0
  client_pki_device_out=""
  client_pki_device_password_file=""

  while (($# > 0)); do
    case "$1" in
      --legacy)
        client_pki_device_legacy=1
        shift
        ;;
      --csr | --fingerprint | --out | --password-file)
        if (($# < 2)); then
          break
        fi
        case "$1" in
          --csr) client_pki_device_csr="$2" ;;
          --fingerprint) client_pki_device_fingerprint="$2" ;;
          --out) client_pki_device_out="$2" ;;
          --password-file) client_pki_device_password_file="$2" ;;
        esac
        shift 2
        ;;
      -*)
        break
        ;;
      *)
        if [[ -n "${client_pki_device_cn}" ]]; then
          break
        fi
        client_pki_device_cn="$1"
        shift
        ;;
    esac
  done
  if (($# > 0)) || [[ -z "${client_pki_device_cn}" ]]; then
    client_pki_device_usage "${device_verb}"
    return 2
  fi
  if [[ -n "${client_pki_device_csr}" ]]; then
    if [[ -n "${client_pki_device_password_file}" ]] || ((client_pki_device_legacy)); then
      echo "client-pki: --csr issues a certificate only, so --password-file and --legacy don't apply" >&2
      client_pki_device_usage "${device_verb}"
      return 2
    fi
    if [[ ! -f "${client_pki_device_csr}" || ! -r "${client_pki_device_csr}" ]]; then
      echo "client-pki: cannot read the CSR ${client_pki_device_csr}" >&2
      return 1
    fi
    client_pki_check_out_writable "${client_pki_device_out:-${client_pki_device_cn}.crt}" || return 1
    return 0
  fi
  if [[ -z "${client_pki_device_password_file}" ]]; then
    client_pki_device_usage "${device_verb}"
    return 2
  fi
  if [[ -n "${client_pki_device_fingerprint}" || -n "${client_pki_device_out}" ]]; then
    echo "client-pki: --fingerprint and --out go with --csr" >&2
    client_pki_device_usage "${device_verb}"
    return 2
  fi
  client_pki_require_private_file "${client_pki_device_password_file}" "password file"
}

# rotate <cn> (--password-file PATH [--legacy] | --csr PATH [--fingerprint HEX]
# [--out PATH]): issue a replacement while the current certificate stays
# valid, and print the serials to revoke once the device has the new one.
client_pki_rotate() {
  local cn previous rc=0
  client_pki_parse_device_args "rotate" "$@" || return
  cn="${client_pki_device_cn}"

  if ! previous="$(client_pki_active_serials "${cn}")"; then
    echo "client-pki: could not list ${cn}'s certificates; nothing issued" >&2
    return 1
  fi
  if [[ -z "${previous}" ]]; then
    echo "client-pki: ${cn} has no active certificate; use 'client-pki enroll ${cn}' instead" >&2
    return 1
  fi
  if [[ -n "${client_pki_device_csr}" ]]; then
    client_pki_sign_csr "${cn}" --keep-previous >/dev/null || rc=$?
    if ((rc != 0)); then
      # Both certificates may be live now: still say which serials to revoke once the device has the new one.
      client_pki_note_issued_but_unwritten "${cn}" "$(printf '%s\n' "${previous}" | grep --count .)"
      client_pki_print_revoke_hints "${previous}" >&2
      return "${rc}"
    fi
    echo "client-pki: wrote ${client_pki_device_out:-${cn}.crt}; install it and the store's public/ca.crt on the device"
  else
    client_pki_tiny_pki create client "${cn}" --keep-previous >/dev/null || return
    client_pki_export_bundle "${cn}" || return
  fi
  client_pki_print_revoke_hints "${previous}"
}

# Print the revoke commands for <serials> (newline-separated, as listed before the rotation).
client_pki_print_revoke_hints() {
  local -r serials="$1"
  local serial

  echo "client-pki: once the device has the new certificate, revoke the previous one:"
  for serial in ${serials}; do
    echo "  ./scripts/client-pki revoke 0x${serial}"
  done
}
