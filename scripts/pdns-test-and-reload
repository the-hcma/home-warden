#!/usr/bin/env bash
# Fail-closed: dns-zones-yaml-check syntax gate, then pdns_control reload,
# then the recursor: rec_control reload-zones, a cache wipe per zone, and an
# SOA probe of every zone apex through it (#127).
# Used by home-warden-pdns-reload.service (systemd path unit) -- mirrors
# scripts/nginx-test-and-reload's pattern for the pdns side.
#
# The recursor config itself (forward_zones, negative trust anchors) stays
# hand-maintained; a zone the recursor does not answer for fails this run
# with the entry to add, rather than being written here.
#
# Env:
#   PDNS_ZONES_YAML  path to thehcma/home's dns/zones.yml (required unless
#                    default resolves)
#   OWNER            account the syntax gate runs as when this script runs as
#                    root (home-warden-pdns-reload.service): the gate execs
#                    `uv run` in this repo, which must not leave root-owned
#                    files in OWNER's uv cache or .venv; default: the repo's
#                    owner. pdns_control itself still runs as root.
#   PDNS_SERVICE     systemd unit name for the distro pdns-server package
#                    (default: pdns.service -- the *package* is
#                    pdns-server, but the *unit* Debian/Ubuntu installs is
#                    just "pdns")
#   PDNS_RECURSOR_SERVICE  recursor unit (default: pdns-recursor.service; the
#                    recursor step is skipped when that default isn't
#                    installed, but an explicitly set unit must exist)
#   PDNS_RECURSOR_ADDRESS  address the zone probes query (default: 127.0.0.1)
#   PDNS_AUTH_FORWARDER    authoritative IPv4-address:port whose SOA answers
#                    the recursor's must match, also suggested as the
#                    forwarder in a missing-zone message (default: 127.0.0.1:853)
#
# Exit:
#   0 — syntax OK and reload succeeded (or service inactive: skip reload)
#   1 — pdns_control reload or rec_control reload-zones failed
#   2 — usage / missing file / syntax check failed / unknown unit
#   3 — reloaded, but the recursor does not answer for one or more zones
#
# Note: this calls `pdns_control reload`, not `systemctl reload
# "${pdns_service}"` -- the distro-packaged pdns.service does not
# implement systemd's reload verb ("Job type reload is not applicable for
# unit pdns.service" on a stock Debian/Ubuntu install), and pdns_control
# reload is PowerDNS's own documented mechanism for picking up
# GeoIP-backend YAML changes without a full restart.
#
# Logging: write to stdout/stderr only. When run from
# home-warden-pdns-reload.service, systemd appends those streams to
# ~/scratch/home-warden/pdns-test-and-reload.log.
#
# Refuses to run anywhere but the host pinned by
# `scripts/setup-service --confirm-host` (see scripts/lib/host-guard).

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck source=scripts/lib/host-guard
source "${script_dir}/lib/host-guard"
if ! hw_host_guard_enforce "pdns-test-and-reload"; then
  exit 1
fi

pdns_zones_yaml="${PDNS_ZONES_YAML:-}"
readonly pdns_zones_yaml
pdns_service="${PDNS_SERVICE:-pdns.service}"
readonly pdns_service
owner="${OWNER:-$(stat -c '%U' "${script_dir}/.." 2>/dev/null || true)}"
readonly owner
pdns_auth_forwarder="${PDNS_AUTH_FORWARDER:-127.0.0.1:853}"
readonly pdns_auth_forwarder
pdns_auth_host="${pdns_auth_forwarder%:*}"
readonly pdns_auth_host
pdns_auth_port="${pdns_auth_forwarder##*:}"
readonly pdns_auth_port
recursor_address="${PDNS_RECURSOR_ADDRESS:-127.0.0.1}"
readonly recursor_address
recursor_service="${PDNS_RECURSOR_SERVICE:-pdns-recursor.service}"
readonly recursor_service

log() {
  local -r msg="$*"
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s %s\n' "${ts}" "${msg}"
}

# probe_recursor_zone <zone> — whether the recursor answers the zone's SOA
# with the same data as the local authoritative server. A zone that also
# exists publicly (split horizon) resolves upstream when it isn't forwarded,
# so a bare NOERROR+SOA would not prove forwarding.
# +adflag matches glibc's trust-ad clients: a recursor that validates DNSSEC
# SERVFAILs a zone under a made-up TLD for them unless it has a negative
# trust anchor, even when forwarding works.
probe_recursor_zone() {
  local -r zone="$1"
  local answer
  local auth_soa
  local recursor_soa
  local status

  if ! answer="$(dig +tries=1 +time=3 +adflag +noall +comments +answer "@${recursor_address}" "${zone}" SOA)"; then
    log "FAIL: recursor ${recursor_address} did not answer for ${zone}"
    return 1
  fi
  status="$(sed -n -E 's/.*status: ([A-Z]+).*/\1/p' <<<"${answer}")"
  recursor_soa="$(awk '$4 == "SOA" { $1 = $2 = $3 = $4 = ""; sub(/^ +/, ""); print; exit }' <<<"${answer}")"
  if [[ "${status}" == "NOERROR" && -n "${recursor_soa}" ]]; then
    if ! auth_soa="$(dig +short +tries=1 +time=3 -p "${pdns_auth_port}" "@${pdns_auth_host}" "${zone}" SOA)"; then
      log "FAIL: the authoritative server on ${pdns_auth_forwarder} did not answer for ${zone}"
      return 1
    fi
    if [[ "${recursor_soa}" == "${auth_soa}" ]]; then
      return 0
    fi
    log "FAIL: recursor answers a different SOA for ${zone} than ${pdns_auth_forwarder} — it resolves the" \
      "zone elsewhere instead of forwarding it; add it to recursor.forward_zones (zone: ${zone}," \
      "forwarders: [${pdns_auth_forwarder}]), then touch zones.yml to rerun this"
    return 1
  fi
  if [[ "${status}" == "SERVFAIL" ]]; then
    log "FAIL: recursor answers SERVFAIL for ${zone} — if it validates DNSSEC, add ${zone} to" \
      "dnssec.negative_trustanchors in its config, then touch zones.yml to rerun this"
    return 1
  fi
  log "FAIL: recursor answers ${status:-no status} for ${zone} SOA — add it to recursor.forward_zones" \
    "(zone: ${zone}, forwarders: [${pdns_auth_forwarder}]), then touch zones.yml to rerun this"
  return 1
}

run_zones_check() {
  local -r zones_yaml="$1"

  if [[ "$(id -u)" -ne 0 || -z "${owner}" || "${owner}" == "root" ]]; then
    "${script_dir}/dns-zones-yaml-check" --list-zones "${zones_yaml}"
    return
  fi
  runuser -u "${owner}" -- "${script_dir}/dns-zones-yaml-check" --list-zones "${zones_yaml}"
}

# A malformed value would otherwise surface later as every zone "not
# answering", pointing at the DNS config instead of the variable.
if [[ ! "${pdns_auth_forwarder}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+$ ]]; then
  log "ERROR: PDNS_AUTH_FORWARDER must be IPv4-address:port (got '${pdns_auth_forwarder}')"
  exit 2
fi
if [[ ! "${recursor_address}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ && ! "${recursor_address}" =~ ^[0-9a-fA-F:]+$ ]]; then
  log "ERROR: PDNS_RECURSOR_ADDRESS must be a bare IP address, without a port (got '${recursor_address}')"
  exit 2
fi

if [[ -z "${pdns_zones_yaml}" ]]; then
  log "ERROR: set PDNS_ZONES_YAML"
  exit 2
fi

if [[ ! -f "${pdns_zones_yaml}" ]]; then
  log "ERROR: zones file not found: ${pdns_zones_yaml}"
  exit 2
fi

log "dns-zones-yaml-check ${pdns_zones_yaml}"
if zone_list="$(run_zones_check "${pdns_zones_yaml}")"; then
  log "syntax OK"
else
  wrapper_status=$?
  if [[ ${wrapper_status} -eq 1 ]]; then
    log "FAIL: dns-zones-yaml-check wrapper error (e.g. uv not found on PATH) — refusing reload"
  else
    log "FAIL: zones.yml syntax check failed — refusing reload"
  fi
  exit 2
fi

pdns_service_load_state="$(systemctl show --property=LoadState --value "${pdns_service}" 2>/dev/null || true)"
readonly pdns_service_load_state
if [[ "${pdns_service_load_state}" == "not-found" ]]; then
  log "ERROR: unknown systemd unit: ${pdns_service} (check PDNS_SERVICE)"
  exit 2
fi

if ! systemctl is-active --quiet "${pdns_service}"; then
  log "${pdns_service} not active — skip reload"
  exit 0
fi

log "pdns_control reload"
if pdns_control reload; then
  log "reload OK"
else
  log "FAIL: pdns_control reload failed"
  exit 1
fi

# reload rereads the YAML but keeps the packet and query caches, so a removed
# record keeps answering (~20s) and a new one stays NXDOMAIN (negquery-cache-ttl,
# 60s) after "reload OK" -- long enough to fail a catalog-register run (#128).
if pdns_control purge >/dev/null; then
  log "cache purge OK"
else
  log "WARN: pdns_control purge failed — stale answers until cache TTLs expire"
fi

readarray -t zones <<<"${zone_list}"
readonly zones

recursor_load_state="$(systemctl show --property=LoadState --value "${recursor_service}" 2>/dev/null || true)"
readonly recursor_load_state
if [[ "${recursor_load_state}" == "not-found" ]]; then
  if [[ -n "${PDNS_RECURSOR_SERVICE:-}" ]]; then
    log "ERROR: unknown systemd unit: ${recursor_service} (check PDNS_RECURSOR_SERVICE)"
    exit 2
  fi
  log "${recursor_service} not installed — skip recursor reload"
  exit 0
fi
if ! systemctl is-active --quiet "${recursor_service}"; then
  log "${recursor_service} not active — skip recursor reload"
  exit 0
fi

# reload-zones rereads forward_zones from the recursor's config, so a zone the
# operator just added there takes effect without a restart (verified on
# pdns-recursor 5.3, #127).
log "rec_control reload-zones"
if ! rec_control reload-zones >/dev/null; then
  log "FAIL: rec_control reload-zones failed"
  exit 1
fi
for zone in "${zones[@]}"; do
  if ! rec_control wipe-cache "${zone}\$" >/dev/null; then
    log "WARN: rec_control wipe-cache ${zone}\$ failed — the recursor may serve stale answers until TTLs expire"
  fi
done

if ! command -v dig >/dev/null 2>&1; then
  log "WARN: dig not found — cannot verify the recursor answers for each zone"
  exit 0
fi
unanswered=0
for zone in "${zones[@]}"; do
  if ! probe_recursor_zone "${zone}"; then
    unanswered=$((unanswered + 1))
  fi
done
if ((unanswered)); then
  log "FAIL: recursor does not answer for ${unanswered} of ${#zones[@]} zone(s)"
  exit 3
fi
log "recursor answers for all ${#zones[@]} zone(s)"
