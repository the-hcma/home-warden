#!/usr/bin/env bash
# Fail-closed: dns-zones-yaml-check syntax gate, then pdns_control reload.
# Used by home-warden-pdns-reload.service (systemd path unit) -- mirrors
# scripts/nginx-test-and-reload's pattern for the pdns side.
#
# Env:
#   PDNS_ZONES_YAML  path to thehcma/home's dns/zones.yml (required unless
#                    default resolves)
#   OWNER            account the syntax gate runs as when this script runs as
#                    root (home-warden-pdns-reload.service): the gate execs
#                    `uv run` in this repo, which must not leave root-owned
#                    files in OWNER's uv cache or .venv; default: the repo's
#                    owner. pdns_control itself still runs as root.
#   PDNS_SERVICE     systemd unit name for the distro pdns-server package
#                    (default: pdns.service -- the *package* is
#                    pdns-server, but the *unit* Debian/Ubuntu installs is
#                    just "pdns")
#
# Exit:
#   0 — syntax OK and reload succeeded (or service inactive: skip reload)
#   1 — pdns_control reload failed
#   2 — usage / missing file / syntax check failed
#
# Note: this calls `pdns_control reload`, not `systemctl reload
# "${pdns_service}"` -- the distro-packaged pdns.service does not
# implement systemd's reload verb ("Job type reload is not applicable for
# unit pdns.service" on a stock Debian/Ubuntu install), and pdns_control
# reload is PowerDNS's own documented mechanism for picking up
# GeoIP-backend YAML changes without a full restart.
#
# Logging: write to stdout/stderr only. When run from
# home-warden-pdns-reload.service, systemd appends those streams to
# ~/scratch/home-warden/pdns-test-and-reload.log.
#
# Refuses to run anywhere but the host pinned by
# `scripts/setup-service --confirm-host` (see scripts/lib/host-guard).

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck source=scripts/lib/host-guard
source "${script_dir}/lib/host-guard"
if ! hw_host_guard_enforce "pdns-test-and-reload"; then
  exit 1
fi

pdns_zones_yaml="${PDNS_ZONES_YAML:-}"
readonly pdns_zones_yaml
pdns_service="${PDNS_SERVICE:-pdns.service}"
readonly pdns_service
owner="${OWNER:-$(stat -c '%U' "${script_dir}/.." 2>/dev/null || true)}"
readonly owner

log() {
  local -r msg=$1
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s %s\n' "${ts}" "${msg}"
}

run_zones_check() {
  local -r zones_yaml="$1"

  if [[ "$(id -u)" -ne 0 || -z "${owner}" || "${owner}" == "root" ]]; then
    "${script_dir}/dns-zones-yaml-check" "${zones_yaml}"
    return
  fi
  runuser -u "${owner}" -- "${script_dir}/dns-zones-yaml-check" "${zones_yaml}"
}

if [[ -z "${pdns_zones_yaml}" ]]; then
  log "ERROR: set PDNS_ZONES_YAML"
  exit 2
fi

if [[ ! -f "${pdns_zones_yaml}" ]]; then
  log "ERROR: zones file not found: ${pdns_zones_yaml}"
  exit 2
fi

log "dns-zones-yaml-check ${pdns_zones_yaml}"
if run_zones_check "${pdns_zones_yaml}"; then
  log "syntax OK"
else
  wrapper_status=$?
  if [[ ${wrapper_status} -eq 1 ]]; then
    log "FAIL: dns-zones-yaml-check wrapper error (e.g. uv not found on PATH) — refusing reload"
  else
    log "FAIL: zones.yml syntax check failed — refusing reload"
  fi
  exit 2
fi

pdns_service_load_state="$(systemctl show --property=LoadState --value "${pdns_service}" 2>/dev/null || true)"
readonly pdns_service_load_state
if [[ "${pdns_service_load_state}" == "not-found" ]]; then
  log "ERROR: unknown systemd unit: ${pdns_service} (check PDNS_SERVICE)"
  exit 2
fi

if ! systemctl is-active --quiet "${pdns_service}"; then
  log "${pdns_service} not active — skip reload"
  exit 0
fi

log "pdns_control reload"
if pdns_control reload; then
  log "reload OK"
else
  log "FAIL: pdns_control reload failed"
  exit 1
fi

# reload rereads the YAML but keeps the packet and query caches, so a removed
# record keeps answering (~20s) and a new one stays NXDOMAIN (negquery-cache-ttl,
# 60s) after "reload OK" -- long enough to fail a catalog-register run (#128).
if pdns_control purge >/dev/null; then
  log "cache purge OK"
else
  log "WARN: pdns_control purge failed — stale answers until cache TTLs expire"
fi
