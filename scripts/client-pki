#!/usr/bin/env bash
# Manage home-warden's private client-certificate CA for mTLS: issue, list,
# revoke, export PKCS#12, refresh the CRL, check expiry, back up and restore.
# Thin wrapper around the tiny-pki CLI (the-hcma/tiny-pki) that pins the store
# to home-warden's location; every tiny-pki verb and flag passes through.
# See docs/client-pki.md and the-hcma/home-warden#49.
#
# Before any command, refuses a store whose permissions are looser than
# tiny-pki's layout (everything but public/ private to you), so a CA key made
# readable by accident is caught instead of used. Anything but a read-only
# verb (list, show, check, inspect, help, completion, --version) is
# host-guarded: it runs only on the designated host (scripts/lib/host-guard).
#
# Env:
#   HOME_WARDEN_PKI_STORE  CA store directory (default: conf/pki in this repo;
#                          conf/ is gitignored, like conf/cloudflare.ini)
#
# `init` encrypts the CA key at rest (tiny-pki --encrypt-key) unless given
# --plaintext-key. The secret comes from --key-secret-file, TINY_PKI_KEY_SECRET_FILE,
# a systemd tiny-pki-key credential (how the CRL timer gets it), or a prompt; never
# argv. Reads (list, show, check, inspect) never need it. See docs/client-pki.md.
#
# Point a catalog vhost's client_cert.ca_bundle / client_cert.crl at the
# store's key-free public/ca.crt and public/crl.pem, never at ca/ (which
# holds the CA key).
#
# Usage:
#   ./scripts/client-pki init --cn "Home client CA" [--key-secret-file PATH | --plaintext-key]
#   ./scripts/client-pki encrypt-key [--key-secret-file PATH]   # migrate a plaintext store
#   ./scripts/client-pki enroll alice-phone --password-file PATH [--legacy]
#   ./scripts/client-pki rotate alice-phone --password-file PATH [--legacy]
#   ./scripts/client-pki enroll bob-laptop --csr PATH [--fingerprint HEX] [--out PATH]
#   ./scripts/client-pki rotate bob-laptop --csr PATH [--fingerprint HEX] [--out PATH]
#   ./scripts/client-pki revoke 0x<old serial>                 # once rotated
#   ./scripts/client-pki revoke alice-phone
#   ./scripts/client-pki list clients
#   ./scripts/client-pki check --quiet
#   ./scripts/client-pki backup --out PATH --passphrase-file PATH
#   ./scripts/client-pki restore --in PATH --passphrase-file PATH

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly repo_dir
store="${HOME_WARDEN_PKI_STORE:-${repo_dir}/conf/pki}"
readonly store

# shellcheck source=scripts/lib/client-pki-devices
source "${repo_dir}/scripts/lib/client-pki-devices"
# shellcheck source=scripts/lib/client-pki-store
source "${repo_dir}/scripts/lib/client-pki-store"
# shellcheck source=scripts/lib/host-guard
source "${repo_dir}/scripts/lib/host-guard"

client_pki_tiny_pki() {
  uv run --project "${repo_dir}" tiny-pki --store "${store}" "$@"
}

is_read_only_verb() {
  case "$1" in
    check | completion | help | inspect | list | show | --help | -h | --version) return 0 ;;
    *) return 1 ;;
  esac
}

usage_backup_restore() {
  echo "usage: client-pki backup --out PATH --passphrase-file PATH" >&2
  echo "       client-pki restore --in PATH --passphrase-file PATH" >&2
}

run_backup_or_restore() {
  local -r verb="$1"
  shift
  local archive_flag="--in"
  local archive="" passphrase_file=""

  if [[ "${verb}" == backup ]]; then
    archive_flag="--out"
  fi
  while (($# >= 2)); do
    case "$1" in
      "${archive_flag}") archive="$2" ;;
      --passphrase-file) passphrase_file="$2" ;;
      *) break ;;
    esac
    shift 2
  done
  if (($# > 0)); then
    usage_backup_restore
    return 2
  fi
  if [[ -z "${archive}" || -z "${passphrase_file}" ]]; then
    usage_backup_restore
    return 2
  fi

  if [[ "${verb}" == backup ]]; then
    client_pki_check_store_permissions "${store}" || return 1
    client_pki_backup "${store}" "${archive}" "${passphrase_file}"
  else
    client_pki_restore "${store}" "${archive}" "${passphrase_file}"
  fi
}

# init: encrypt the CA key unless the operator opts out with --plaintext-key
# (which only this wrapper knows) or already passed --encrypt-key.
client_pki_init() {
  local arg
  local encrypt=1
  local -a args=()

  for arg in "$@"; do
    case "${arg}" in
      --plaintext-key) encrypt=0 ;;
      --encrypt-key) ;;
      *) args+=("${arg}") ;;
    esac
  done
  if ((encrypt)); then
    args+=(--encrypt-key)
  else
    echo "client-pki: WARNING: --plaintext-key leaves the CA key unencrypted at rest" >&2
  fi
  exec uv run --project "${repo_dir}" tiny-pki --store "${store}" init "${args[@]}"
}

requested_verb="${1:-}"
readonly requested_verb

if ! is_read_only_verb "${requested_verb}" && ! hw_host_guard_enforce "client-pki"; then
  exit 1
fi

case "${requested_verb}" in
  backup | restore)
    run_backup_or_restore "$@"
    exit
    ;;
esac

if ! command -v uv >/dev/null 2>&1; then
  echo "client-pki: install uv (https://docs.astral.sh/uv/) or run 'uv sync' in ${repo_dir}" >&2
  exit 1
fi

client_pki_check_store_permissions "${store}"

case "${requested_verb}" in
  enroll)
    shift
    client_pki_locked "${store}/ca" client_pki_enroll "$@"
    ;;
  rotate)
    shift
    client_pki_locked "${store}/ca" client_pki_rotate "$@"
    ;;
  init)
    shift
    client_pki_init "$@"
    ;;
  *)
    exec uv run --project "${repo_dir}" tiny-pki --store "${store}" "$@"
    ;;
esac
