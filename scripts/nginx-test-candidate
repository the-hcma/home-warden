#!/usr/bin/env bash
# Privileged nginx -t helper for web UI preview/apply validation.
#
# Source template installed by scripts/setup-service as the root-owned
# /usr/local/sbin/home-warden-nginx-test-candidate helper. The installed copy
# bakes in a fixed preview config path and accepts no caller-controlled path.

set -euo pipefail

readonly owner_home="@@OWNER_HOME@@"
readonly pinned_host_file="${owner_home}/.config/home-warden-host"
readonly pinned_machine_id_file="${owner_home}/.config/home-warden-machine-id"
readonly preview_conf="@@PREVIEW_CONF@@"

usage() {
  echo "Usage: home-warden-nginx-test-candidate" >&2
}

current_hostname_short() {
  hostname -s 2>/dev/null || hostname
}

current_machine_id() {
  tr -d '[:space:]' </etc/machine-id 2>/dev/null || true
}

first_line() {
  local -r path="$1"
  local line=""
  [[ -f "${path}" ]] || return 0
  IFS= read -r line <"${path}" || true
  printf '%s\n' "${line}"
}

if ((EUID != 0)); then
  echo "nginx-test-candidate: run via sudo/root" >&2
  exit 2
fi

if [[ $# -ne 0 ]]; then
  usage
  exit 2
fi

export HOME="${owner_home}"
if [[ "${HOME_WARDEN_SKIP_HOST_GUARD:-0}" != "1" ]]; then
  pinned_host="$(first_line "${pinned_host_file}")"
  pinned_machine_id="$(first_line "${pinned_machine_id_file}")"
  readonly pinned_host
  readonly pinned_machine_id

  if [[ -z "${pinned_host}" && -z "${pinned_machine_id}" ]]; then
    echo "nginx-test-candidate: refusing to run — home-warden has no designated host yet" >&2
    exit 1
  fi

  if [[ "${pinned_host}" != "$(current_hostname_short)" && "${pinned_machine_id}" != "$(current_machine_id)" ]]; then
    echo "nginx-test-candidate: refusing to run — this host ($(current_hostname_short)) is not the designated home-warden host" >&2
    exit 1
  fi
fi

if [[ ! -f "${preview_conf}" ]]; then
  echo "nginx-test-candidate: conf not found: ${preview_conf}" >&2
  exit 2
fi

nginx_bin="/usr/sbin/nginx"
if [[ ! -x "${nginx_bin}" ]]; then
  nginx_bin="$(command -v nginx 2>/dev/null || true)"
fi
if [[ -z "${nginx_bin}" ]]; then
  echo "nginx-test-candidate: nginx binary not found" >&2
  exit 2
fi
readonly nginx_bin

exec "${nginx_bin}" -t -c "${preview_conf}"
