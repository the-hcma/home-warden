# Local secrets / live certs (never commit)
*.pem
*.key
certs/
.env
.env.*

# Runtime / scratch
scratch/
*.log
*.pid

# Graphite / start-development stack worktrees
.worktrees/

# Editor / OS
.DS_Store
*.swp

# Python (uv-managed; uv.lock stays tracked)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local conf (examples stay tracked as conf/*.example)
conf/*
!conf/*.example
!conf/README.md

# Web UI (the-hcma/home-warden#55/#67) -- esbuild output + pnpm store are
# build artifacts, not source; web/pnpm-lock.yaml stays tracked.
web/node_modules/
app/api/static/dist/
