#!/usr/bin/env bash
# ci/nginx-security-lint — sync the `lint` uv dependency group (Gixy-Next)
# and run scripts/nginx-security-lint against this repo's nginx/nginx.conf
# fixture. See the-hcma/home-warden#50.
set -euo pipefail
bash .github/ci/setup-python
uv sync --group lint
./scripts/nginx-security-lint --verbose
