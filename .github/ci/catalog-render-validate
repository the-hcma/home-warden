#!/usr/bin/env bash
# ci/catalog-render-validate — render a CI-only catalog fixture, then
# validate the output with both `nginx -t` and Gixy-Next
# (scripts/nginx-security-lint) -- the two validation layers #54 requires
# before catalog-driven config is trustworthy. See the-hcma/home-warden#54.
#
# render-catalog's output is the http{}/stream{} content meant to be
# included into a full nginx.conf (worker_processes/events/pid/error_log
# live in the served config's own skeleton, not in the catalog) -- so this
# wraps it in the same minimal top-level skeleton nginx/nginx.conf's CI
# fixture uses, purely to give `nginx -t` a complete file to validate.
#
# Uses a small, dedicated fixture catalog (not services.json.example) --
# services.json.example's paths are intentionally documentation-only
# placeholders (see its own _notes and .cursor/rules/no-private-infra.mdc),
# so `nginx -t` needs real, generated cert/CA/CRL files at matching paths
# instead. services.json.example itself is still exercised structurally by
# tests/python/test_catalog_render.py's crossplane.parse() round-trip.
set -euo pipefail
bash .github/ci/setup-python
uv sync --group lint

work_dir="$(mktemp -d)"

uv run python3 - "${work_dir}" <<'PY'
import datetime
import sys
from pathlib import Path

from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.x509.oid import NameOID

work_dir = Path(sys.argv[1])
now = datetime.datetime.now(datetime.timezone.utc)


def make_cert(domain: str) -> None:
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, domain)])
    cert = (
        x509.CertificateBuilder()
        .subject_name(name)
        .issuer_name(name)
        .public_key(key.public_key())
        .serial_number(x509.random_serial_number())
        .not_valid_before(now)
        .not_valid_after(now + datetime.timedelta(days=1))
        .add_extension(x509.SubjectAlternativeName([x509.DNSName(domain)]), critical=False)
        .sign(key, hashes.SHA256())
    )
    domain_dir = work_dir / "certs" / domain
    domain_dir.mkdir(parents=True, exist_ok=True)
    (domain_dir / "fullchain.pem").write_bytes(cert.public_bytes(serialization.Encoding.PEM))
    (domain_dir / "privkey.pem").write_bytes(
        key.private_bytes(
            serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()
        )
    )


for domain in ("ci-proxy.example.com", "ci-static.example.com", "ci-mtls.example.com"):
    make_cert(domain)

ca_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
ca_name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "ci-render-validate test CA")])
ca_cert = (
    x509.CertificateBuilder()
    .subject_name(ca_name)
    .issuer_name(ca_name)
    .public_key(ca_key.public_key())
    .serial_number(x509.random_serial_number())
    .not_valid_before(now)
    .not_valid_after(now + datetime.timedelta(days=1))
    .add_extension(x509.BasicConstraints(ca=True, path_length=None), critical=True)
    .sign(ca_key, hashes.SHA256())
)
crl = (
    x509.CertificateRevocationListBuilder()
    .issuer_name(ca_name)
    .last_update(now)
    .next_update(now + datetime.timedelta(days=1))
    .sign(ca_key, hashes.SHA256())
)
mtls_dir = work_dir / "mtls"
mtls_dir.mkdir(parents=True, exist_ok=True)
(mtls_dir / "ca.pem").write_bytes(ca_cert.public_bytes(serialization.Encoding.PEM))
(mtls_dir / "ca.crl").write_bytes(crl.public_bytes(serialization.Encoding.PEM))
PY

fixture_json="${work_dir}/services.json"
cat >"${fixture_json}" <<EOF
{
  "services": [
    {
      "name": "ci-proxy",
      "server_name": "ci-proxy.example.com",
      "kind": "proxy",
      "upstream": {"scheme": "http", "host": "::1", "port": 8080, "path": "/"},
      "websocket": true,
      "forward_host_header": true,
      "allow_cidrs": ["10.0.0.0/24"]
    },
    {
      "name": "ci-static",
      "server_name": "ci-static.example.com",
      "kind": "static",
      "static": {"root": "${work_dir}/static-root", "listing_path": "/listing/"}
    },
    {
      "name": "ci-mtls",
      "server_name": "ci-mtls.example.com",
      "kind": "proxy",
      "upstream": {"scheme": "http", "host": "127.0.0.1", "port": 8081, "path": "/"},
      "client_cert": {
        "mode": "required",
        "ca_bundle": "${work_dir}/mtls/ca.pem",
        "verify_depth": 1,
        "crl": "${work_dir}/mtls/ca.crl",
        "allow_cn": ["ci-render-validate test client"]
      }
    }
  ],
  "streams": [
    {"name": "ci-stream", "listen_port": 8883, "upstream": {"host": "::1", "port": 8883}}
  ]
}
EOF
mkdir -p "${work_dir}/static-root"

rendered="${work_dir}/catalog.conf"
uv run render-catalog \
  --services-json "${fixture_json}" \
  --certs-live-dir "${work_dir}/certs" \
  --output "${rendered}"

full_conf="${work_dir}/nginx.conf"
cat >"${full_conf}" <<EOF
worker_processes 1;
error_log ${work_dir}/nginx-error.log warn;
pid ${work_dir}/nginx.pid;
events {
    worker_connections 64;
}
include ${rendered};
EOF

nginx -t -c "${full_conf}"
# proxy_buffering_off: inherent to websocket support (a persistent
# connection can't be buffered) -- not a footgun in this catalog's use.
# proxy_pass_normalized: every proxy_pass this renderer emits has a fixed,
# catalog-declared path behind a whole-vhost `location /` (no partial
# prefix to mis-normalize against) -- the schema's documented behavior,
# not an accident.
GIXY_SKIPS="proxy_buffering_off,proxy_pass_normalized" HOME_NGINX_CONF="${full_conf}" ./scripts/nginx-security-lint --verbose
